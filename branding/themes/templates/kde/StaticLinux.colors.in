# Static Linux — Plasma colour scheme, rendered by sl-theme from the active
# theme ({{name}}). sl-theme also merges these groups into kdeglobals.
[General]
ColorScheme=StaticLinux
Name=Static Linux
shadeSortColumn=true

[ColorEffects:Disabled]
Color={{line_rgb}}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{line_rgb}}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate={{tint25_rgb}}
BackgroundNormal={{surface_rgb}}
DecorationFocus={{accent_rgb}}
DecorationHover={{accent_hi_rgb}}
ForegroundActive={{accent_hi_rgb}}
ForegroundInactive={{text_dim_rgb}}
ForegroundLink={{accent_rgb}}
ForegroundNegative={{danger_rgb}}
ForegroundNeutral={{warning_rgb}}
ForegroundNormal={{text_rgb}}
ForegroundPositive={{accent_rgb}}
ForegroundVisited={{accent_lo_rgb}}

[Colors:Selection]
BackgroundAlternate={{accent_lo_rgb}}
BackgroundNormal={{accent_rgb}}
DecorationFocus={{accent_rgb}}
DecorationHover={{accent_hi_rgb}}
ForegroundActive={{accent_fg_rgb}}
ForegroundInactive={{accent_fg_rgb}}
ForegroundLink={{accent_fg_rgb}}
ForegroundNegative={{danger_rgb}}
ForegroundNeutral={{warning_rgb}}
ForegroundNormal={{accent_fg_rgb}}
ForegroundPositive={{accent_fg_rgb}}
ForegroundVisited={{accent_fg_rgb}}

[Colors:Tooltip]
BackgroundAlternate={{tint8_rgb}}
BackgroundNormal={{surface_rgb}}
DecorationFocus={{accent_rgb}}
DecorationHover={{accent_hi_rgb}}
ForegroundActive={{accent_hi_rgb}}
ForegroundInactive={{text_dim_rgb}}
ForegroundLink={{accent_rgb}}
ForegroundNegative={{danger_rgb}}
ForegroundNeutral={{warning_rgb}}
ForegroundNormal={{text_rgb}}
ForegroundPositive={{accent_rgb}}
ForegroundVisited={{accent_lo_rgb}}

[Colors:View]
BackgroundAlternate={{tint8_rgb}}
BackgroundNormal={{surface_rgb}}
DecorationFocus={{accent_rgb}}
DecorationHover={{accent_hi_rgb}}
ForegroundActive={{accent_hi_rgb}}
ForegroundInactive={{text_dim_rgb}}
ForegroundLink={{accent_rgb}}
ForegroundNegative={{danger_rgb}}
ForegroundNeutral={{warning_rgb}}
ForegroundNormal={{text_rgb}}
ForegroundPositive={{accent_rgb}}
ForegroundVisited={{accent_lo_rgb}}

[Colors:Window]
