# Static Linux — i3 colours and bar, written by sl-theme ({{name}}).
# ~/.config/i3/config includes this file; don't edit it, run sl-theme.
font pango:{{font_ui}} 10
default_border pixel 2
default_floating_border pixel 2
gaps inner 6
gaps outer 4
#                       border      background  text        indicator   child_border
client.focused          #{{accent}} #{{accent}} #{{accent_fg}} #{{accent_hi}} #{{accent}}
client.focused_inactive #{{line}}   #{{surface}} #{{text}}  #{{line}}   #{{line}}
client.unfocused        #{{line}}   #{{bg}}     #{{text_dim}} #{{line}} #{{line}}
client.urgent           #{{danger}} #{{danger}} #{{bg}}     #{{danger}} #{{danger}}
client.background       #{{bg}}

bar {
    position top
    status_command i3status
    font pango:{{font_ui}} 10
    tray_output primary
    separator_symbol " · "
    colors {
        background #{{bg}}
        statusline #{{text}}
        separator  #{{line}}
        #                  border      background  text
        focused_workspace  #{{accent}} #{{accent}} #{{accent_fg}}
        active_workspace   #{{line}}   #{{surface}} #{{text}}
        inactive_workspace #{{bg}}     #{{bg}}     #{{text_dim}}
        urgent_workspace   #{{danger}} #{{danger}} #{{bg}}
    }
}
