#!/bin/sh
# Static Linux — bspwm colours, written by sl-theme ({{name}}).
# bspwmrc sources this; sl-theme runs it again on a theme change.
bspc config border_width         2
bspc config window_gap           8
bspc config normal_border_color  "#{{line}}"
bspc config active_border_color  "#{{line}}"
bspc config focused_border_color "#{{accent}}"
bspc config presel_feedback_color "#{{accent}}"
