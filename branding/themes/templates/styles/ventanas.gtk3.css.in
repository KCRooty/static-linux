/* style: ventanas (close to Windows 11). Flat, 4 px controls, accent only
 * on the default button, the focus ring and the active app's underline. */
button { border-radius: 4px; }
button.suggested-action, button.default { background-color: #{{accent}}; color: #{{accent_fg}}; }
headerbar, .titlebar { background-color: #{{bg}}; border-bottom: none; box-shadow: none; }

/* ---- XFCE taskbar: 48 px at the bottom, apps centred ---- */
.xfce4-panel.background { background-color: #{{surface}}; border-top: 1px solid #{{line}}; }
.xfce4-panel button { border-radius: 4px; padding: 0 8px; margin: 4px 1px; color: #{{text}}; transition: background-color 120ms ease-out; }
.xfce4-panel button:hover { background-color: alpha(#{{text}}, 0.08); }
.xfce4-panel button:checked { background-color: alpha(#{{text}}, 0.06); box-shadow: inset 0 -3px #{{accent}}; }
.xfce4-panel label { font-family: "{{font_ui}}"; font-size: 9pt; }

/* ---- whisker menu: the start menu ---- */
#whiskermenu-window { background-color: #{{surface}}; border: 1px solid #{{line}}; border-radius: 8px; }
#whiskermenu-window entry { background-color: #{{bg}}; border-radius: 4px; border-bottom: 2px solid #{{accent}}; }
#whiskermenu-window button:hover, #whiskermenu-window treeview:selected { background-color: alpha(#{{text}}, 0.08); color: #{{text}}; }
