# Static Linux — GRUB theme, rendered by sl-theme ({{name}}).
title-text: ""
desktop-image: "background.png"
desktop-image-scale-method: "crop"
desktop-color: "#{{bg}}"
terminal-font: "{{grub_font_mono}}"
terminal-box: "menu_*.png"

+ label {
    left = 50%-320
    top = 22%
    width = 640
    height = 40
    align = "center"
    text = "Static Linux"
    font = "{{grub_font_big}}"
    color = "#{{text}}"
}

+ boot_menu {
    left = 50%-320
    top = 22%+64
    width = 640
    height = 44%
    menu_pixmap_style = "menu_*.png"
    item_font = "{{grub_font_small}}"
    item_color = "#{{text}}"
    selected_item_font = "{{grub_font_small}}"
    selected_item_color = "#{{accent_fg}}"
    selected_item_pixmap_style = "select_*.png"
    item_height = 36
    item_padding = 14
    item_spacing = 6
    icon_width = 0
    icon_height = 0
    item_icon_space = 0
    scrollbar = true
    scrollbar_width = 4
    scrollbar_thumb = "thumb_*.png"
}

+ label {
    left = 50%-320
    top = 22%+64+44%+18
    width = 640
    height = 24
    align = "center"
    id = "__timeout__"
    text = "Arrancando en %d s"
    font = "{{grub_font_small}}"
    color = "#{{text_dim}}"
}

+ label {
    left = 0
    top = 100%-44
    width = 100%
    height = 24
    align = "center"
    text = "Flechas: elegir  ·  Intro: arrancar  ·  e: editar  ·  c: consola"
    font = "{{grub_font_small}}"
    color = "#{{text_dim}}"
}
