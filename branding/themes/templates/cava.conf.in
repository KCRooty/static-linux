; Static Linux · {{name}} (generated by sl-theme)
[general]
framerate = 30
bars = 0
bar_width = 2
bar_spacing = 1
; sleep when nothing plays (DESIGN.md: motion only when it informs)
sleep_timer = 3

[input]
method = pulse

[color]
background = default
gradient = 1
gradient_count = 3
gradient_color_1 = '#{{text_dim}}'
gradient_color_2 = '#{{accent}}'
gradient_color_3 = '#{{text}}'

[smoothing]
noise_reduction = 77
