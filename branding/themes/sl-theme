#!/usr/bin/env python3
"""sl-theme: apply a Static Linux theme (wallpaper + palette) to the whole look.

    sl-theme --list                  themes and which one is active
    sl-theme --current               print the active theme id
    sl-theme ambar                   apply to the invoking user
    sl-theme papel --user testu      apply to another user's home (root)
    sl-theme ambar --skel            render into /etc/skel (ISO build, root)

A theme is branding/themes/<id>/theme.conf + wallpaper.jpg (see DESIGN.md).
Every file this script overwrites is copied first to
~/.local/state/static-linux/theme-backup/<timestamp>/, so nothing is lost.
Templates live in templates/; MANIFEST lists template -> destination.
"""

from __future__ import annotations

import argparse
import os
import pwd
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
INSTALLED = Path("/usr/share/static-linux/themes")
THEMES = INSTALLED if (INSTALLED / "ambar").is_dir() else HERE
TEMPLATES = THEMES / "templates"
DEFAULT = "ambar"

sys.path.insert(0, str(THEMES))
import check  # noqa: E402  (same folder: contrast rules)
import icons  # noqa: E402  (folder-coloured Papirus)
import xfwm4  # noqa: E402  (window decoration generator)


def log(msg: str) -> None:
    print(f"\033[1;33m[theme]\033[0m {msg}")


def die(msg: str) -> None:
    print(f"\033[1;31m[theme]\033[0m {msg}", file=sys.stderr)
    sys.exit(1)


def theme_ids() -> list[str]:
    return sorted(p.name for p in THEMES.iterdir() if (p / "theme.conf").is_file())


def load_theme(theme_id: str) -> dict[str, str]:
    path = THEMES / theme_id / "theme.conf"
    if not path.is_file():
        die(f"unknown theme '{theme_id}' (sl-theme --list)")
    theme = check.load(path)
    errors = check.check(theme_id, theme)
    if errors:
        die(f"theme '{theme_id}' fails DESIGN.md contrast rules: {errors[0]}")
    # derived values the templates use
    for i, colour in enumerate(theme["term"].split(",") + theme["term_bright"].split(",")):
        theme[f"term{i}"] = colour
    wall = THEMES / theme_id / "wallpaper.jpg"
    theme["wallpaper"] = str(wall if wall.is_file() else "")
    theme["id"] = theme_id
    theme.setdefault("folders", "yellow")
    theme["gtk_theme"] = "adw-gtk3" if theme["mode"] == "light" else "adw-gtk3-dark"
    theme["color_scheme"] = "prefer-light" if theme["mode"] == "light" else "prefer-dark"
    theme.setdefault("style", "minimal")
    if theme["style"] not in xfwm4.STYLES:
        die(f"theme '{theme_id}': unknown style '{theme['style']}' (one of {', '.join(xfwm4.STYLES)})")
    theme.setdefault("font_ui", "Space Grotesk")
    theme["dark_mode"] = "false" if theme["mode"] == "light" else "true"
    theme["radius_ctl"] = {"minimal": "6", "aero": "4", "ventanas": "4"}[theme["style"]]
    # tints the styles draw with (gloss, hover rows): bg pulled towards the accent
    for pct in (8, 15, 25, 40):
        theme[f"tint{pct}"] = xfwm4._mix(theme["bg"], theme["accent"], pct / 100)
    theme["accent_hi"] = xfwm4._mix(theme["accent"], "FFFFFF", 0.35)
    theme["accent_lo"] = xfwm4._mix(theme["accent"], "000000", 0.20)
    for key in ("bg", "surface", "line", "text", "text_dim", "accent", "accent_fg"):
        theme[f"{key}_rgb"] = ",".join(str(int(theme[key][i:i + 2], 16)) for i in (0, 2, 4))
        theme[f"{key}_ansi"] = "38;2;" + theme[f"{key}_rgb"].replace(",", ";")
    return theme


def render(text: str, theme: dict[str, str]) -> str:
    def sub(m: re.Match) -> str:
        key = m.group(1)
        if key not in theme:
            die(f"template uses unknown key {{{{{key}}}}}")
        return theme[key]
    return re.sub(r"\{\{\s*([a-z0-9_]+)\s*\}\}", sub, text)


def style_partial(theme: dict[str, str], kind: str) -> str:
    """Rendered templates/styles/<style>.<kind>.in, or "" if the style has none."""
    path = TEMPLATES / "styles" / f"{theme['style']}.{kind}.in"
    return render(path.read_text(), theme) if path.is_file() else ""


PANEL = ".config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml"
PANEL_STYLE = ".config/static-linux/panel-style"


def manifest() -> list[tuple[str, str]]:
    rows = []
    for line in (TEMPLATES / "MANIFEST").read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            src, dest = line.split()
            rows.append((src, dest))
    return rows


class Writer:
    """Writes files under a home, backing up whatever it replaces once."""

    def __init__(self, home: Path, owner: tuple[int, int] | None) -> None:
        self.home = home
        self.owner = owner
        stamp = time.strftime("%Y%m%d-%H%M%S")
        self.backup = home / ".local/state/static-linux/theme-backup" / stamp

    def write(self, rel: str, data: str | bytes) -> None:
        dest = self.home / rel
        if dest.is_file():
            saved = self.backup / rel
            saved.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(dest, saved)
            self.chown(saved)  # run as root (installer): the user must own the backups too
        dest.parent.mkdir(parents=True, exist_ok=True)
        if isinstance(data, bytes):
            dest.write_bytes(data)
        else:
            dest.write_text(data)
        self.chown(dest)

    def link(self, rel: str, target: str) -> None:
        dest = self.home / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        if dest.is_symlink() or dest.exists():
            dest.unlink()
        dest.symlink_to(target)
        if self.owner:
            os.lchown(dest, *self.owner)
            self.chown(dest.parent)

    def chown(self, path: Path) -> None:
        if not self.owner:
            return
        # own every directory we may have created between home and the file
        for p in [path, *path.parents]:
            if p == self.home:
                break
            os.chown(p, *self.owner)


def xfconf_from_xml(xml_text: str) -> list[tuple[str, str, str, str]]:
    """(channel, property, type, value) for every leaf property of a rendered
    xfconf channel file, so the running session gets exactly what skel gets."""
    import xml.etree.ElementTree as ET
    root = ET.fromstring(xml_text)
    out = []
    def walk(node, path):
        for prop in node.findall("property"):
            p = f"{path}/{prop.get('name')}"
            if prop.get("type") not in ("empty", "array") and prop.get("value") is not None:
                out.append((root.get("name"), p, prop.get("type"), prop.get("value")))
            walk(prop, p)
    walk(root, "")
    return out


def xfconf(theme: dict[str, str], user: str | None, channels: list[str]) -> None:
    """Point the running XFCE session at the new files (no-op outside one)."""
    settings = [
        ("xsettings", "/Net/ThemeName", theme["gtk_theme"]),
        ("xsettings", "/Net/IconThemeName", "StaticLinux"),
        ("xsettings", "/Gtk/FontName", f"{theme['font_ui']} 10"),
        ("xsettings", "/Gtk/MonospaceFontName", "JetBrains Mono 10"),
        ("xfwm4", "/general/theme", "StaticLinux"),
        ("xfwm4", "/general/title_font", f"{theme['font_ui']} Medium 10"),
        ("xfwm4", "/general/button_layout", xfwm4.BUTTON_LAYOUT[theme["style"]]),
    ]
    typed = [(c, p, "string", v) for c, p, v in settings]
    for xml_text in channels:
        typed += xfconf_from_xml(xml_text)
    env = dict(os.environ)
    prefix: list[str] = []
    if user and os.geteuid() == 0:
        uid = pwd.getpwnam(user).pw_uid
        bus = f"/run/user/{uid}/bus"
        if not Path(bus).exists():
            return
        prefix = ["runuser", "-u", user, "--"]
        env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={bus}"
    if not shutil.which("xfconf-query"):
        return
    for channel, prop, kind, value in typed:
        subprocess.run(prefix + ["xfconf-query", "-c", channel, "-p", prop, "-n", "-t", kind, "-s", value],
                       env=env, stderr=subprocess.DEVNULL, check=False)
    # wallpaper on every monitor/workspace xfdesktop already knows about
    out = subprocess.run(prefix + ["xfconf-query", "-c", "xfce4-desktop", "-l"], env=env,
                         capture_output=True, text=True, check=False).stdout
    for prop in out.split():
        if prop.endswith("/last-image"):
            subprocess.run(prefix + ["xfconf-query", "-c", "xfce4-desktop", "-p", prop, "-s", theme["wallpaper"]],
                           env=env, check=False)


def xfconf_arrays(xml_text: str) -> list[tuple[str, list[tuple[str, str]]]]:
    """(property, [(type, value)...]) for every array property of a channel file."""
    import xml.etree.ElementTree as ET
    out = []
    def walk(node, path):
        for prop in node.findall("property"):
            p = f"{path}/{prop.get('name')}"
            if prop.get("type") == "array":
                out.append((p, [(v.get("type"), v.get("value")) for v in prop.findall("value")]))
            walk(prop, p)
    walk(ET.fromstring(xml_text), "")
    return out


def swap_panel(w: Writer, theme: dict[str, str], user: str | None) -> None:
    """Load the style's panel layout. With a session running, xfconfd owns the
    channel (it would write its copy over our file), so the layout goes in
    through xfconf-query: reset the channel, set every property, restart the
    panel. Without a session, writing the file is enough."""
    text = render((TEMPLATES / "panels" / f"{theme['style']}.xml").read_text(), theme)
    prefix: list[str] = []
    env = dict(os.environ)
    if user and os.geteuid() == 0:
        uid = pwd.getpwnam(user).pw_uid
        prefix = ["runuser", "-u", user, "--"]
        env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path=/run/user/{uid}/bus"
    running = shutil.which("xfconf-query") and subprocess.run(
        ["pgrep", "-u", user or str(os.getuid()), "-x", "xfce4-panel"], capture_output=True).returncode == 0
    if not running:
        w.write(PANEL, text)
        return
    q = prefix + ["xfconf-query", "-c", "xfce4-panel"]
    subprocess.run(q + ["-p", "/", "-r", "-R"], env=env, check=False, stderr=subprocess.DEVNULL)
    for _channel, prop, kind, value in xfconf_from_xml(text):
        subprocess.run(q + ["-p", prop, "-n", "-t", kind, "-s", value], env=env, check=False,
                       stderr=subprocess.DEVNULL)
    for prop, values in xfconf_arrays(text):
        args = [a for kind, value in values for a in ("-t", kind, "-s", value)]
        subprocess.run(q + ["-p", prop, "-n", "--force-array", *args], env=env, check=False,
                       stderr=subprocess.DEVNULL)
    # the restart talks to the display: borrow DISPLAY/XAUTHORITY from the panel itself
    pid = subprocess.run(["pgrep", "-u", user or str(os.getuid()), "-x", "xfce4-panel"],
                         capture_output=True, text=True).stdout.split()
    try:
        raw = Path(f"/proc/{pid[0]}/environ").read_bytes().split(b"\0")
        for item in raw:
            key, _, value = item.decode(errors="replace").partition("=")
            if key in ("DISPLAY", "XAUTHORITY", "WAYLAND_DISPLAY"):
                env[key] = value
    except (IndexError, OSError):
        pass
    subprocess.run(prefix + ["env", *[f"{k}={env[k]}" for k in ("DISPLAY", "XAUTHORITY") if k in env],
                             "xfce4-panel", "-r"], env=env, check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def apply(theme_id: str, mode: str, user: str | None) -> None:
    theme = load_theme(theme_id)
    if mode == "skel":
        home, owner = Path("/etc/skel"), None
    else:
        name = user or os.environ.get("SUDO_USER") or pwd.getpwuid(os.getuid()).pw_name
        entry = pwd.getpwnam(name)
        home, owner = Path(entry.pw_dir), (entry.pw_uid, entry.pw_gid)
        if os.geteuid() != 0 and entry.pw_uid != os.getuid():
            die("applying to another user's home needs root")
        if os.geteuid() != 0:
            owner = None
        user = name
    w = Writer(home, owner)
    theme["style_gtk3"] = style_partial(theme, "gtk3.css")
    theme["style_gtk4"] = style_partial(theme, "gtk4.css")
    channels = []
    for src, dest in manifest():
        text = render((TEMPLATES / src).read_text(), theme)
        w.write(dest, text)
        if "/xfce-perchannel-xml/" in dest:
            channels.append(text)
    icon_dir = home / ".local/share/icons/StaticLinux"
    if icon_dir.is_dir():  # only our own symlinks live here: rebuild from scratch
        shutil.rmtree(icon_dir)
    folder_links = icons.links(theme["folders"])
    for rel, target in folder_links.items():
        w.link(f".local/share/icons/StaticLinux/{rel}", target)
    w.write(".local/share/icons/StaticLinux/index.theme", icons.index_theme(theme, list(folder_links)))
    for rel, data in xfwm4.generate(theme).items():
        w.write(f".local/share/themes/StaticLinux/xfwm4/{rel}", data)
    for custom in (".config/gtk-3.0/gtk-custom.css", ".config/gtk-4.0/gtk-custom.css"):
        if not (home / custom).exists():  # the user's own rules: create, never overwrite
            w.write(custom, "/* Your own GTK rules. sl-theme never touches this file. */\n")
    w.write(".config/static-linux/theme", theme_id + "\n")
    # the bar's layout belongs to the style: only rewrite it when the style
    # changes, so a user's own panel tweaks survive palette-only switches
    old_style = (home / PANEL_STYLE).read_text().strip() if (home / PANEL_STYLE).is_file() else "minimal"
    new_panel = mode == "skel" or old_style != theme["style"]
    if new_panel:
        w.write(PANEL_STYLE, theme["style"] + "\n")
    log(f"{theme['name']} ({theme['style']}) written to {home}")
    if mode == "skel":
        w.write(PANEL, render((TEMPLATES / "panels" / f"{theme['style']}.xml").read_text(), theme))
    else:
        xfconf(theme, user, channels)
        if new_panel:
            swap_panel(w, theme, user)


def current() -> str:
    path = Path.home() / ".config/static-linux/theme"
    return path.read_text().strip() if path.is_file() else DEFAULT


def main() -> None:
    ap = argparse.ArgumentParser(prog="sl-theme", description=__doc__.splitlines()[0])
    ap.add_argument("theme", nargs="?")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--current", action="store_true")
    ap.add_argument("--user")
    ap.add_argument("--skel", action="store_true")
    args = ap.parse_args()
    if args.list:
        active = current()
        for tid in theme_ids():
            t = check.load(THEMES / tid / "theme.conf")
            print(f"{'*' if tid == active else ' '} {tid:10} {t.get('name', tid)} ({t.get('mode')})")
        return
    if args.current:
        print(current())
        return
    if not args.theme:
        ap.error("pick a theme (sl-theme --list)")
    apply(args.theme, "skel" if args.skel else "home", args.user)


if __name__ == "__main__":
    main()
