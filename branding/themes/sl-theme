def log(msg: str) -> None:
    print(f"\033[1;33m[theme]\033[0m {msg}")


def die(msg: str) -> None:
    print(f"\033[1;31m[theme]\033[0m {msg}", file=sys.stderr)
    sys.exit(1)


def theme_ids() -> list[str]:
    return sorted(p.name for p in THEMES.iterdir() if (p / "theme.conf").is_file())


def load_theme(theme_id: str) -> dict[str, str]:
    path = THEMES / theme_id / "theme.conf"
    if not path.is_file():
        die(f"unknown theme '{theme_id}' (sl-theme --list)")
    theme = check.load(path)
    errors = check.check(theme_id, theme)
    if errors:
        die(f"theme '{theme_id}' fails DESIGN.md contrast rules: {errors[0]}")
    # derived values the templates use
    for i, colour in enumerate(theme["term"].split(",") + theme["term_bright"].split(",")):
        theme[f"term{i}"] = colour
    wall = THEMES / theme_id / "wallpaper.jpg"
    theme["wallpaper"] = str(wall if wall.is_file() else "")
    theme["id"] = theme_id
    theme.setdefault("folders", "yellow")
    theme["gtk_theme"] = "adw-gtk3" if theme["mode"] == "light" else "adw-gtk3-dark"
    theme["color_scheme"] = "prefer-light" if theme["mode"] == "light" else "prefer-dark"
    theme.setdefault("style", "minimal")
    if theme["style"] not in xfwm4.STYLES:
        die(f"theme '{theme_id}': unknown style '{theme['style']}' (one of {', '.join(xfwm4.STYLES)})")
    theme.setdefault("font_ui", "Space Grotesk")
    theme["dark_mode"] = "false" if theme["mode"] == "light" else "true"
    theme["dark_int"] = "0" if theme["mode"] == "light" else "1"
    theme["icon_base"] = "Papirus-Light" if theme["mode"] == "light" else "Papirus-Dark"
    theme["radius_ctl"] = {"minimal": "6", "aero": "4", "ventanas": "4", "estante": "16"}[theme["style"]]
    theme["radius_win"] = {"minimal": "10", "aero": "8", "ventanas": "3", "estante": "12"}[theme["style"]]
    # tints the styles draw with (gloss, hover rows): bg pulled towards the accent
    for pct in (8, 15, 25, 40):
        theme[f"tint{pct}"] = xfwm4._mix(theme["bg"], theme["accent"], pct / 100)
    theme["accent_hi"] = xfwm4._mix(theme["accent"], "FFFFFF", 0.35)
    theme["accent_lo"] = xfwm4._mix(theme["accent"], "000000", 0.20)
    # every colour also as "r,g,b", r/g/b alone (0-255) and a truecolor escape
    for key, value in list(theme.items()):
        if not re.fullmatch(r"[0-9A-Fa-f]{6}", value or ""):
            continue
        rgb = [int(value[i:i + 2], 16) for i in (0, 2, 4)]
        theme[f"{key}_rgb"] = ",".join(map(str, rgb))
        theme[f"{key}_r"], theme[f"{key}_g"], theme[f"{key}_b"] = map(str, rgb)
        theme[f"{key}_ansi"] = "38;2;" + ";".join(map(str, rgb))
    return theme


def render(text: str, theme: dict[str, str]) -> str:
    def sub(m: re.Match) -> str:
        key = m.group(1)
        if key not in theme:
            die(f"template uses unknown key {{{{{key}}}}}")
        return theme[key]
    # {{_ "Texto"}}: a visible string, in the session (or, with --system, the system) language
    text = re.sub(r'\{\{_\s*"([^"]+)"\s*\}\}', lambda m: tr(m.group(1)).replace('"', "'"), text)
    return re.sub(r"\{\{\s*([a-z0-9_]+)\s*\}\}", sub, text)


def style_partial(theme: dict[str, str], kind: str) -> str:
    """Rendered templates/styles/<style>.<kind>.in, or "" if the style has none."""
    path = TEMPLATES / "styles" / f"{theme['style']}.{kind}.in"
    return render(path.read_text(), theme) if path.is_file() else ""


PANEL = ".config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml"
PANEL_STYLE = ".config/static-linux/panel-style"
DOCKLIKE_RC = ".config/xfce4/panel/docklike-3.rc"


def manifest() -> list[tuple[str, str, str | None]]:
    """(template, destination, program or None) for every MANIFEST row."""
    rows = []
    for line in (TEMPLATES / "MANIFEST").read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            src, dest, *needs = line.split()
            rows.append((src, dest, needs[0] if needs else None))
    return rows


class Writer:
    """Writes files under a home, backing up whatever it replaces once."""

    def __init__(self, home: Path, owner: tuple[int, int] | None) -> None:
        self.home = home
        self.owner = owner
        stamp = time.strftime("%Y%m%d-%H%M%S")
        self.backup = home / ".local/state/static-linux/theme-backup" / stamp

    def write(self, rel: str, data: str | bytes) -> None:
        dest = self.home / rel
        if dest.is_file():
            saved = self.backup / rel
            saved.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(dest, saved)
            self.chown(saved)  # run as root (installer): the user must own the backups too
        dest.parent.mkdir(parents=True, exist_ok=True)
        if isinstance(data, bytes):
            dest.write_bytes(data)
        else:
            dest.write_text(data)
        if data[:2] in ("#!", b"#!"):
            dest.chmod(0o755)
        self.chown(dest)

    def link(self, rel: str, target: str) -> None:
        dest = self.home / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        if dest.is_symlink() or dest.exists():
            dest.unlink()
        dest.symlink_to(target)
        if self.owner:
            os.lchown(dest, *self.owner)
            self.chown(dest.parent)

    def chown(self, path: Path) -> None:
        if not self.owner:
            return
        # own every directory we may have created between home and the file
        for p in [path, *path.parents]:
            if p == self.home:
                break
            os.chown(p, *self.owner)


# Per-style desktop behaviour: (channel, property, type, value with the style,
# value without it). None removes the property, so the XFCE default is back.
XFCONF_DIR = ".config/xfce4/xfconf/xfce-perchannel-xml"
STYLE_XFCONF = {
    "estante": [
        # notifications pop up above the shelf, bottom right
        ("xfce4-notifyd", "/notify-location", "uint", "3", None),
        # a clean desktop: no icons on it, files live in the launcher and Thunar
        ("xfce4-desktop", "/desktop-icons/style", "int", "0", None),
        # Alt+[ / Alt+] snap the window to the left/right half, Alt+= maximises
        ("xfce4-keyboard-shortcuts", "/xfwm4/custom/<Alt>bracketleft", "string", "tile_left_key", None),
        ("xfce4-keyboard-shortcuts", "/xfwm4/custom/<Alt>bracketright", "string", "tile_right_key", None),
        ("xfce4-keyboard-shortcuts", "/xfwm4/custom/<Alt>equal", "string", "maximize_window_key", None),
    ],
}


def style_settings(style: str) -> list[tuple[str, str, str, str | None]]:
    """(channel, prop, type, value-or-None) for every per-style key."""
    out = []
    for owner, rows in STYLE_XFCONF.items():
        for channel, prop, kind, on, off in rows:
            out.append((channel, prop, kind, on if owner == style else off))
    return out


def xfconf_xml_set(w: Writer, channel: str, prop: str, kind: str, value: str | None) -> None:
    """Set (or remove) one property in a channel's XML under the home, keeping
    everything else. Used when no xfconfd is running (installer, skel)."""
    import xml.etree.ElementTree as ET
    rel = f"{XFCONF_DIR}/{channel}.xml"
    path = w.home / rel
    if path.is_file():
        # keep the comments that explain the defaults (skel files have them)
        root = ET.fromstring(path.read_text(), parser=ET.XMLParser(target=ET.TreeBuilder(insert_comments=True)))
    elif value is None:
        return
    else:
        root = ET.Element("channel", {"name": channel, "version": "1.0"})
    node = root
    parts = prop.strip("/").split("/")
    for i, name in enumerate(parts):
        child = next((c for c in node.findall("property") if c.get("name") == name), None)
        last = i == len(parts) - 1
        if child is None:
            if value is None:
                return
            child = ET.SubElement(node, "property", {"name": name, "type": kind if last else "empty"})
        if last:
            if value is None:
                node.remove(child)
            else:
                child.set("type", kind)
                child.set("value", value)
        node = child
    ET.indent(root, "  ")
    w.write(rel, '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding="unicode") + "\n")


def xfconf_live(theme: dict[str, str], user: str | None) -> None:
    """The same per-style keys in a running session (xfconfd owns them there)."""
    if not shutil.which("xfconf-query"):
        return
    env = dict(os.environ)
    prefix: list[str] = []
    if user and os.geteuid() == 0:
        bus = f"/run/user/{pwd.getpwnam(user).pw_uid}/bus"
        if not Path(bus).exists():
            return
        prefix = ["runuser", "-u", user, "--"]
        env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={bus}"
    for channel, prop, kind, value in style_settings(theme["style"]):
        cmd = prefix + ["xfconf-query", "-c", channel, "-p", prop]
        cmd += ["-r"] if value is None else ["-n", "-t", kind, "-s", value]
        subprocess.run(cmd, env=env, stderr=subprocess.DEVNULL, check=False)


def xfconf_from_xml(xml_text: str) -> list[tuple[str, str, str, str]]:
    """(channel, property, type, value) for every leaf property of a rendered
    xfconf channel file, so the running session gets exactly what skel gets."""
    import xml.etree.ElementTree as ET
    root = ET.fromstring(xml_text)
    out = []
    def walk(node, path):
        for prop in node.findall("property"):
            p = f"{path}/{prop.get('name')}"
            if prop.get("type") not in ("empty", "array") and prop.get("value") is not None:
                out.append((root.get("name"), p, prop.get("type"), prop.get("value")))
            walk(prop, p)
    walk(root, "")
    return out


def session_settings(theme: dict[str, str]) -> list[tuple[str, str, str]]:
    """(channel, prop, value) the XFCE session needs to pick up the theme:
    GTK theme, icons, fonts and the generated xfwm4 decorations."""
    return [
        ("xsettings", "/Net/ThemeName", theme["gtk_theme"]),
        ("xsettings", "/Net/IconThemeName", "StaticLinux"),
        ("xsettings", "/Gtk/FontName", f"{theme['font_ui']} 10"),
        ("xsettings", "/Gtk/MonospaceFontName", "JetBrains Mono 10"),
        ("xfwm4", "/general/theme", "StaticLinux"),
        ("xfwm4", "/general/title_font", f"{theme['font_ui']} Medium 10"),
        ("xfwm4", "/general/button_layout", xfwm4.BUTTON_LAYOUT[theme["style"]]),
    ]


def xfconf(theme: dict[str, str], user: str | None, channels: list[str]) -> None:
    """Point the running XFCE session at the new files (no-op outside one)."""
    typed = [(c, p, "string", v) for c, p, v in session_settings(theme)]
    for xml_text in channels:
        typed += xfconf_from_xml(xml_text)
    env = dict(os.environ)
    prefix: list[str] = []
    if user and os.geteuid() == 0:
        uid = pwd.getpwnam(user).pw_uid
        bus = f"/run/user/{uid}/bus"
        if not Path(bus).exists():
            return
        prefix = ["runuser", "-u", user, "--"]
        env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={bus}"
    if not shutil.which("xfconf-query"):
        return
    for channel, prop, kind, value in typed:
        subprocess.run(prefix + ["xfconf-query", "-c", channel, "-p", prop, "-n", "-t", kind, "-s", value],
                       env=env, stderr=subprocess.DEVNULL, check=False)
    # wallpaper on every monitor/workspace xfdesktop already knows about
    out = subprocess.run(prefix + ["xfconf-query", "-c", "xfce4-desktop", "-l"], env=env,
                         capture_output=True, text=True, check=False).stdout
    for prop in out.split():
        if prop.endswith("/last-image"):
            subprocess.run(prefix + ["xfconf-query", "-c", "xfce4-desktop", "-p", prop, "-s", theme["wallpaper"]],
                           env=env, check=False)


def xfconf_arrays(xml_text: str) -> list[tuple[str, list[tuple[str, str]]]]:
    """(property, [(type, value)...]) for every array property of a channel file."""
    import xml.etree.ElementTree as ET
    out = []
    def walk(node, path):
        for prop in node.findall("property"):
            p = f"{path}/{prop.get('name')}"
            if prop.get("type") == "array":
                out.append((p, [(v.get("type"), v.get("value")) for v in prop.findall("value")]))
            walk(prop, p)
    walk(ET.fromstring(xml_text), "")
    return out


def swap_panel(w: Writer, theme: dict[str, str], user: str | None) -> None:
    """Load the style's panel layout. With a session running, xfconfd owns the
    channel (it would write its copy over our file), so the layout goes in
    through xfconf-query: reset the channel, set every property, restart the
    panel. Without a session, writing the file is enough."""
    text = render((TEMPLATES / "panels" / f"{theme['style']}.xml").read_text(), theme)
    prefix: list[str] = []
    env = dict(os.environ)
    if user and os.geteuid() == 0:
        uid = pwd.getpwnam(user).pw_uid
        prefix = ["runuser", "-u", user, "--"]
        env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path=/run/user/{uid}/bus"
    running = shutil.which("xfconf-query") and subprocess.run(
        ["pgrep", "-u", user or str(os.getuid()), "-x", "xfce4-panel"], capture_output=True).returncode == 0
    if not running:
        w.write(PANEL, text)
        return
    q = prefix + ["xfconf-query", "-c", "xfce4-panel"]
    subprocess.run(q + ["-p", "/", "-r", "-R"], env=env, check=False, stderr=subprocess.DEVNULL)
    for _channel, prop, kind, value in xfconf_from_xml(text):
        subprocess.run(q + ["-p", prop, "-n", "-t", kind, "-s", value], env=env, check=False,
                       stderr=subprocess.DEVNULL)
    for prop, values in xfconf_arrays(text):
        args = [a for kind, value in values for a in ("-t", kind, "-s", value)]
        subprocess.run(q + ["-p", prop, "-n", "--force-array", *args], env=env, check=False,
                       stderr=subprocess.DEVNULL)
    # the restart talks to the display: borrow DISPLAY/XAUTHORITY from the panel itself
    pid = subprocess.run(["pgrep", "-u", user or str(os.getuid()), "-x", "xfce4-panel"],
                         capture_output=True, text=True).stdout.split()
    try:
        raw = Path(f"/proc/{pid[0]}/environ").read_bytes().split(b"\0")
        for item in raw:
            key, _, value = item.decode(errors="replace").partition("=")
            if key in ("DISPLAY", "XAUTHORITY", "WAYLAND_DISPLAY"):
                env[key] = value
    except (IndexError, OSError):
        pass
    subprocess.run(prefix + ["env", *[f"{k}={env[k]}" for k in ("DISPLAY", "XAUTHORITY") if k in env],
                             "xfce4-panel", "-r"], env=env, check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def ensure_line(w: Writer, rel: str, line: str, header: str = "") -> None:
    """Make sure a config file contains `line` (create it, or append once)."""
    path = w.home / rel
    text = path.read_text() if path.is_file() else header
    if line not in text.splitlines():
        w.write(rel, text + ("" if not text or text.endswith("\n") else "\n") + line + "\n")


def ini_merge(w: Writer, rel: str, groups: dict[str, dict[str, str]]) -> None:
    """Set keys in a KDE-style ini file, keeping every other group and key."""
    path = w.home / rel
    lines = path.read_text().splitlines() if path.is_file() else []
    out: list[str] = []
    pending = {g: dict(kv) for g, kv in groups.items()}
    group = None
    def flush(g):
        for k, v in pending.pop(g, {}).items():
            out.append(f"{k}={v}")
    for line in lines:
        m = re.fullmatch(r"\[(.+)\]", line.strip())
        if m:
            if group in pending:
                flush(group)
            group = m.group(1)
            out.append(line)
            continue
        key = line.split("=", 1)[0].strip()
        if group in pending and key in pending[group]:
            out.append(f"{key}={pending[group].pop(key)}")
            continue
        out.append(line)
    if group in pending:
        flush(group)
    for g in list(pending):
        out += ["", f"[{g}]"]
        flush(g)
    w.write(rel, "\n".join(out).lstrip("\n") + "\n")


def kde_globals(w: Writer, theme: dict[str, str]) -> None:
    """Plasma reads its colours from kdeglobals: merge the scheme's groups in,
    so the theme shows even before Plasma's own tools run."""
    scheme = render((TEMPLATES / "kde/StaticLinux.colors.in").read_text(), theme)
    groups: dict[str, dict[str, str]] = {}
    group = None
    for line in scheme.splitlines():
        m = re.fullmatch(r"\[(.+)\]", line.strip())
        if m:
            group = m.group(1)
            continue
        if group and group.startswith(("Colors:", "WM")) and "=" in line:
            k, v = line.split("=", 1)
            groups.setdefault(group, {})[k] = v
    groups["General"] = {"ColorScheme": "StaticLinux", "AccentColor": theme["accent_rgb"],
                         "accentColorFromWallpaper": "false"}
    groups["Icons"] = {"Theme": "StaticLinux"}
    groups["KDE"] = {"LookAndFeelPackage": "org.kde.breeze.desktop" if theme["mode"] == "light"
                     else "org.kde.breezedark.desktop"}
    ini_merge(w, ".config/kdeglobals", groups)
    ini_merge(w, ".config/konsolerc", {"Desktop Entry": {"DefaultProfile": "StaticLinux.profile"}})


def session_env(user: str | None, procs: list[str]) -> tuple[list[str], dict[str, str]] | None:
    """Command prefix + environment to talk to the user's running session,
    borrowed from the first of `procs` that runs for that user (None if none)."""
    who = user or pwd.getpwuid(os.getuid()).pw_name
    for name in procs:
        pids = subprocess.run(["pgrep", "-u", who, "-x", name], capture_output=True,
                              text=True).stdout.split()
        if not pids:
            continue
        env = dict(os.environ)
        try:
            for item in Path(f"/proc/{pids[0]}/environ").read_bytes().split(b"\0"):
                key, _, value = item.decode(errors="replace").partition("=")
                if key in ("DISPLAY", "XAUTHORITY", "WAYLAND_DISPLAY", "DBUS_SESSION_BUS_ADDRESS",
                           "XDG_RUNTIME_DIR", "HYPRLAND_INSTANCE_SIGNATURE"):
                    env[key] = value
        except OSError:
            pass
        if "Hyprland" in name:
            # the compositor exports these to its children, not to itself:
            # find them in the user's runtime dir
            run_dir = Path(env.get("XDG_RUNTIME_DIR") or f"/run/user/{pwd.getpwnam(who).pw_uid}")
            env["XDG_RUNTIME_DIR"] = str(run_dir)
            inst = sorted((run_dir / "hypr").glob("*/.socket.sock"), key=lambda f: f.stat().st_mtime)
            if inst and not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
                env["HYPRLAND_INSTANCE_SIGNATURE"] = inst[-1].parent.name
            socks = sorted(f.name for f in run_dir.glob("wayland-*") if not f.name.endswith(".lock"))
            if socks and not env.get("WAYLAND_DISPLAY"):
                env["WAYLAND_DISPLAY"] = socks[0]
        prefix = ["runuser", "-u", who, "--"] if os.geteuid() == 0 and who != "root" else []
        return prefix, env
    return None


GNOME_PROCS = ["gnome-shell", "cinnamon", "Hyprland", ".Hyprland-wrapped", "plasmashell",
               "xfce4-session", "openbox", "sway", "i3", "bspwm"]


CINNAMON_CSS = Path("/usr/share/cinnamon/theme/cinnamon.css")


def cinnamon_theme(w: Writer, theme: dict[str, str]) -> None:
    """Cinnamon's panel, menu and popups come from its own St theme, drawn
    with a fixed dark palette: rebuild it with the theme's colours, mapping
    each stock colour to the role it plays (base, raised, hover, line...)."""
    if not CINNAMON_CSS.is_file():
        return
    css = CINNAMON_CSS.read_text()
    roles = {
        "bg": ["242428", "1a1a1f", "303034", "323234", "1e1e21"],
        "surface": ["39393c"],
        "tint15": ["454549", "484850"],
        "tint25": ["656569", "55555c"],
        "line": ["333337"],
        "text_dim": ["7c7c7e", "b2b2b4", "cccccc"],
        "accent": ["3584e4", "1f76e1"],
        "accent_hi": ["629fea", "78aeed"],
        "danger": ["c01c28", "aa1923", "e4705b", "ff7b63"],
        "warning": ["f8e45c"],
    }
    for role, stock in roles.items():
        for hexc in stock:
            css = re.sub(f"#{hexc}\\b", f"#{theme[role]}", css, flags=re.I)
    rgba = {"255, 255, 255": "text", "36, 36, 40": "bg", "26, 26, 31": "bg", "51, 51, 55": "line"}
    for stock, role in rgba.items():
        css = css.replace(f"rgba({stock},", f"rgba({theme[role + '_r']}, {theme[role + '_g']}, {theme[role + '_b']},")
    css = re.sub(r"(?<=[:\s])white(?=\s*[;}])", f"#{theme['text']}", css)
    css = re.sub(r"(?<=[:\s])black(?=\s*[;}])", f"#{theme['accent_fg']}", css)
    # images stay in the stock theme folder
    css = re.sub(r'url\("(?!/)([^"]+)"\)', f'url("{CINNAMON_CSS.parent}/\\1")', css)
    w.write(".local/share/themes/StaticLinux/cinnamon/cinnamon.css",
            f"/* Static Linux — Cinnamon theme from {theme['name']}, built by sl-theme from\n"
            f"   {CINNAMON_CSS}. Don't edit: run sl-theme. */\n" + css)


# GNOME 47+ only takes a named accent: the closest hue wins
GNOME_ACCENTS = {"blue": 214, "teal": 180, "green": 135, "yellow": 48, "orange": 28,
                 "red": 357, "pink": 330, "purple": 270}


def gnome_accent(hexcolour: str) -> str:
    import colorsys
    r, g, b = (int(hexcolour[i:i + 2], 16) / 255 for i in (0, 2, 4))
    h, l, sat = colorsys.rgb_to_hls(r, g, b)
    if sat < 0.18:
        return "slate"
    hue = h * 360
    return min(GNOME_ACCENTS, key=lambda n: min(abs(hue - GNOME_ACCENTS[n]), 360 - abs(hue - GNOME_ACCENTS[n])))


def gnome_prefs(theme: dict[str, str], home: Path, user: str | None) -> None:
    """org.gnome.desktop.interface: libadwaita apps (Nautilus, Loupe...) follow
    color-scheme, not the GTK theme, and GNOME/Cinnamon read the rest from here.
    In a running session the session bus gets it; otherwise a private bus
    writes straight into <home>/.config/dconf/user (installer, --skel)."""
    if not shutil.which("gsettings"):
        return
    keys = [("color-scheme", theme["color_scheme"]), ("gtk-theme", theme["gtk_theme"]),
            ("icon-theme", "StaticLinux"), ("font-name", f"{theme['font_ui']} 10"),
            ("monospace-font-name", "JetBrains Mono 10")]
    uri = f"file://{theme['wallpaper']}"
    rows = [("org.gnome.desktop.interface", k, v) for k, v in keys]
    rows += [("org.gnome.desktop.interface", "accent-color", gnome_accent(theme["accent"])),
             ("org.gnome.desktop.background", "picture-uri", uri),
             ("org.gnome.desktop.background", "picture-uri-dark", uri),
             ("org.gnome.desktop.background", "picture-options", "zoom"),
             ("org.cinnamon.desktop.interface", "gtk-theme", theme["gtk_theme"]),
             ("org.cinnamon.desktop.interface", "icon-theme", "StaticLinux"),
             ("org.cinnamon.desktop.interface", "font-name", f"{theme['font_ui']} 10"),
             ("org.cinnamon.desktop.wm.preferences", "theme", theme["gtk_theme"]),
             ("org.cinnamon.theme", "name", "StaticLinux" if CINNAMON_CSS.is_file() else "cinnamon"),
             ("org.cinnamon.desktop.background", "picture-uri", uri),
             ("org.cinnamon.desktop.background", "picture-options", "zoom")]
    # a schema that isn't installed just fails that line; the rest still runs
    script = "; ".join(f"gsettings set {sch} {k} '{v}' 2>/dev/null" for sch, k, v in rows)
    s = session_env(user, GNOME_PROCS) if user else None
    if s and s[1].get("DBUS_SESSION_BUS_ADDRESS"):
        prefix, env = s
        subprocess.run(prefix + ["env", f"DBUS_SESSION_BUS_ADDRESS={env['DBUS_SESSION_BUS_ADDRESS']}",
                                 "sh", "-c", script], env=env, check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    if not shutil.which("dbus-run-session"):
        return
    prefix = ["runuser", "-u", user, "--"] if user and os.geteuid() == 0 else []
    env = {"PATH": os.environ.get("PATH", "/usr/bin"), "HOME": str(home),
           "XDG_CONFIG_HOME": str(home / ".config")}
    subprocess.run(prefix + ["env", *[f"{k}={v}" for k, v in env.items()],
                             "dbus-run-session", "--", "sh", "-c", script],
                   check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def refresh_session(theme: dict[str, str], user: str | None) -> None:
    """Nudge whatever is running so the new files show without logging out."""
    def run(prefix, env, *cmd, background=False):
        keep = [f"{k}={env[k]}" for k in ("DISPLAY", "XAUTHORITY", "WAYLAND_DISPLAY",
                "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR", "HYPRLAND_INSTANCE_SIGNATURE") if k in env]
        full = prefix + ["env", *keep, *cmd]
        if background:
            subprocess.Popen(full, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        else:
            subprocess.run(full, env=env, check=False, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
    if (s := session_env(user, ["openbox"])):
        run(*s, "openbox", "--reconfigure")
        run(*s, "sh", "-c", "[ -x ~/.fehbg ] && ~/.fehbg")
    if (s := session_env(user, ["tint2"])):
        run(*s, "pkill", "-USR1", "-x", "tint2")
    if (s := session_env(user, ["dunst"])):
        run(*s, "dunstctl", "reload")
    if (s := session_env(user, ["i3"])):
        run(*s, "sh", "-c", "[ -x ~/.fehbg ] && ~/.fehbg")
        run(*s, "i3-msg", "reload")
    if (s := session_env(user, ["bspwm"])):
        run(*s, "sh", "-c", ". ~/.config/bspwm/theme.sh; [ -x ~/.fehbg ] && ~/.fehbg")
    if (s := session_env(user, ["polybar"])):
        run(*s, "polybar-msg", "cmd", "restart")
    if (s := session_env(user, ["sway"])):
        run(*s, "swaymsg", "reload")
    if (s := session_env(user, ["waybar"])):
        run(*s, "pkill", "-SIGUSR2", "-x", "waybar")
    if (s := session_env(user, ["mako"])):
        run(*s, "makoctl", "reload")
    if (s := session_env(user, ["cinnamon"])) and CINNAMON_CSS.is_file():
        # same theme name = no reload: bounce through the stock theme
        run(*s, "gsettings", "set", "org.cinnamon.theme", "name", "cinnamon")
        run(*s, "gsettings", "set", "org.cinnamon.theme", "name", "StaticLinux")
    if (s := session_env(user, ["Hyprland", ".Hyprland-wrapped"])):
        run(*s, "hyprctl", "reload")
        run(*s, "pkill", "-x", "hyprpaper")
        run(*s, "pkill", "-x", "swaybg")
        # same fallback as static.lua: swaybg where hyprpaper can't draw
        run(*s, "sh", "-c", f"hyprpaper || exec swaybg -m fill -i '{theme['wallpaper']}'", background=True)
    if (s := session_env(user, ["plasmashell"])):
        # re-applying the scheme that is already active is a no-op in Plasma
        run(*s, "plasma-apply-colorscheme", "BreezeDark" if theme["mode"] == "light" else "BreezeLight")
        run(*s, "plasma-apply-colorscheme", "StaticLinux")
        run(*s, "plasma-apply-wallpaperimage", theme["wallpaper"])


def apply(theme_id: str, mode: str, user: str | None) -> None:
    theme = load_theme(theme_id)
    if mode == "system":
        if os.geteuid() != 0:
            die("--system needs root")
        system.apply(theme, render, TEMPLATES / "system", log)
        Path("/etc/static-linux").mkdir(parents=True, exist_ok=True)
        Path("/etc/static-linux/theme").write_text(theme_id + "\n")
        return
    if mode == "skel":
        home, owner = Path("/etc/skel"), None
    else:
        name = user or os.environ.get("SUDO_USER") or pwd.getpwuid(os.getuid()).pw_name
        entry = pwd.getpwnam(name)
        home, owner = Path(entry.pw_dir), (entry.pw_uid, entry.pw_gid)
        if os.geteuid() != 0 and entry.pw_uid != os.getuid():
            die("applying to another user's home needs root")
        if os.geteuid() != 0:
            owner = None
        user = name
    w = Writer(home, owner)
    theme["style_gtk3"] = style_partial(theme, "gtk3.css")
    theme["style_gtk4"] = style_partial(theme, "gtk4.css")
    channels = []
    for src, dest, needs in manifest():
        if needs and not shutil.which(needs):
            continue
        text = render((TEMPLATES / src).read_text(), theme)
        w.write(dest, text)
        if "/xfce-perchannel-xml/" in dest:
            channels.append(text)
    icon_dir = home / ".local/share/icons/StaticLinux"
    if icon_dir.is_dir():  # only our own symlinks live here: rebuild from scratch
        shutil.rmtree(icon_dir)
    folder_links = icons.links(theme["folders"])
    for rel, target in folder_links.items():
        w.link(f".local/share/icons/StaticLinux/{rel}", target)
    w.write(".local/share/icons/StaticLinux/index.theme", icons.index_theme(theme, list(folder_links)))
    for rel, data in xfwm4.generate(theme).items():
        w.write(f".local/share/themes/StaticLinux/xfwm4/{rel}", data)
    for custom in (".config/gtk-3.0/gtk-custom.css", ".config/gtk-4.0/gtk-custom.css"):
        if not (home / custom).exists():  # the user's own rules: create, never overwrite
            w.write(custom, "/* Your own GTK rules. sl-theme never touches this file. */\n")
    if shutil.which("kitty"):
        ensure_line(w, ".config/kitty/kitty.conf", "include static-linux-theme.conf",
                    "# Your kitty settings. sl-theme only adds the include below.\n")
    if shutil.which("plasmashell"):
        kde_globals(w, theme)
    if shutil.which("cinnamon"):
        cinnamon_theme(w, theme)
    w.write(".config/static-linux/theme", theme_id + "\n")
    # the bar's layout belongs to the style: only rewrite it when the style
    # changes, so a user's own panel tweaks survive palette-only switches
    old_style = (home / PANEL_STYLE).read_text().strip() if (home / PANEL_STYLE).is_file() else "minimal"
    new_panel = mode == "skel" or old_style != theme["style"]
    if new_panel:
        w.write(PANEL_STYLE, theme["style"] + "\n")
    log(f"{theme['name']} ({theme['style']}) written to {home}")
    # the channel files too: skel ships them with the old defaults and, with
    # no session running (installer, --skel), nothing else would update them
    if (home / XFCONF_DIR).is_dir():
        for channel, prop, value in session_settings(theme):
            xfconf_xml_set(w, channel, prop, "string", value)
    if new_panel:
        for channel, prop, kind, value in style_settings(theme["style"]):
            xfconf_xml_set(w, channel, prop, kind, value)
    if new_panel and theme["style"] == "estante":
        # the dock keeps its pinned apps in its own rc file, not in xfconf
        w.write(DOCKLIKE_RC, (TEMPLATES / "panels" / "docklike.rc").read_text())
    gnome_prefs(theme, home, None if mode == "skel" else user)
    if mode == "skel":
        w.write(PANEL, render((TEMPLATES / "panels" / f"{theme['style']}.xml").read_text(), theme))
    else:
        xfconf(theme, user, channels)
        if new_panel:
            swap_panel(w, theme, user)
            xfconf_live(theme, user)
        refresh_session(theme, user)


def current() -> str:
    path = Path.home() / ".config/static-linux/theme"
    return path.read_text().strip() if path.is_file() else DEFAULT


def main() -> None:
    ap = argparse.ArgumentParser(prog="sl-theme", description=__doc__.splitlines()[0])
    ap.add_argument("theme", nargs="?")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--current", action="store_true")
    ap.add_argument("--user")
    ap.add_argument("--skel", action="store_true")
    ap.add_argument("--system", action="store_true",
                    help="login screen, GRUB and boot splash for the whole machine (root)")
    ap.add_argument("--no-initramfs", action="store_true",
                    help="with --system: leave the initramfs alone (the installer rebuilds it)")
    args = ap.parse_args()
    if args.list:
        active = current()
        for tid in theme_ids():
            t = check.load(THEMES / tid / "theme.conf")
            print(f"{'*' if tid == active else ' '} {tid:10} {t.get('name', tid)} ({t.get('mode')})")
        return
    if args.current:
        print(current())
        return
    if not args.theme:
        ap.error("pick a theme (sl-theme --list)")
    system.REBUILD_INITRAMFS = not args.no_initramfs
    apply(args.theme, "system" if args.system else "skel" if args.skel else "home", args.user)


if __name__ == "__main__":
    main()
