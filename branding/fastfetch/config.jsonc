// Static Linux — fastfetch
// Install to /etc/fastfetch/config.jsonc (system default for every user).
// Logos in /usr/share/static-linux/fastfetch/
//
// Accent: light purple #C0A0F0 -> 38;2;192;160;240   (dim -> 38;2;138;120;170)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "/usr/share/static-linux/fastfetch/logo-static-linux.fastfetch",
    "color": { "1": "38;2;192;160;240" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },

  "display": {
    "separator": "   ",
    "color": { "keys": "38;2;192;160;240", "output": "38;2;205;205;215" }
  },

  "modules": [
    { "type": "title", "format": "{#38;2;192;160;240}{user-name}{#38;2;138;120;170}@{#38;2;192;160;240}{host-name}" },
    { "type": "custom", "format": "{#38;2;138;120;170}fast. private. yours." },
    "break",
    { "type": "os",       "key": "distro " },
    { "type": "kernel",   "key": "kernel ", "format": "{2}" },
    { "type": "packages", "key": "pkgs   ", "format": "{pacman}" },
    { "type": "uptime",   "key": "uptime ", "format": "{?1}{1}d {?}{?2}{2}h {?}{3}m" },
    { "type": "shell",    "key": "shell  ", "format": "{1} {4}" },
    "break",
    { "type": "de",       "key": "desktop", "format": "{2}" },
    { "type": "wm",       "key": "wm     ", "format": "{1}" },
    { "type": "wmtheme",  "key": "theme  " },
    { "type": "terminal", "key": "term   ", "format": "{5}" },
    "break",
    { "type": "cpu",      "key": "cpu    ", "format": "{1}" },
    { "type": "gpu",      "key": "gpu    ", "format": "{2}", "temp": false },
    { "type": "memory",   "key": "memory ", "format": "{1} / {2}" },
    { "type": "disk",     "key": "disk   ", "folders": "/", "format": "{1} / {2}" },
    "break",
    { "type": "colors", "symbol": "circle", "block": { "width": 2 } }
  ]
}
