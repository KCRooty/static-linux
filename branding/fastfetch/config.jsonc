// Static Linux — fastfetch config
// Install to /etc/fastfetch/config.jsonc (system default for every user).
// Logos live in /usr/share/static-linux/fastfetch/  (logo-*.fastfetch)
//
// Palette:  Signal Green #00C8A0 -> 38;2;0;200;160
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "/usr/share/static-linux/fastfetch/logo-static-linux.fastfetch",
    "color": { "1": "38;2;0;200;160" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },

  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;0;200;160", "title": "38;2;0;200;160" }
  },

  "modules": [
    { "type": "title", "format": "{user-name}{#90}@{#38;2;0;200;160}{host-name}" },
    { "type": "custom", "format": "{#90}fast. private. yours." },
    "break",
    { "type": "os",       "key": "  distro " },
    { "type": "kernel",   "key": "  kernel " },
    { "type": "packages", "key": "  pkgs   " },
    { "type": "uptime",   "key": "  uptime " },
    { "type": "shell",    "key": "  shell  " },
    "break",
    { "type": "de",       "key": "  desktop" },
    { "type": "wm",       "key": "  wm     " },
    { "type": "wmtheme",  "key": "  theme  " },
    { "type": "terminal", "key": "  term   " },
    "break",
    { "type": "cpu",      "key": "  cpu    " },
    { "type": "gpu",      "key": "  gpu    " },
    { "type": "memory",   "key": "  memory " },
    { "type": "disk",     "key": "  disk   ", "folders": "/" },
    { "type": "localip",  "key": "  net    ", "compact": true },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
