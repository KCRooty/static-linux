// Static Linux — fastfetch, minimal.
// Install to /etc/fastfetch/config.jsonc (system default for every user).
// Logos in /usr/share/static-linux/fastfetch/  (logo-*.fastfetch)
//
// Palette:  Signal Green #00C8A0 -> 38;2;0;200;160 · dim -> 90
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "/usr/share/static-linux/fastfetch/logo-sf-block.fastfetch",
    "color": { "1": "38;2;0;200;160", "2": "38;2;230;232;238" },
    "padding": { "top": 1, "left": 3, "right": 4 }
  },

  "display": {
    "separator": "  ",
    "color": { "keys": "90", "output": "37" },
    "percent": { "type": 1 }
  },

  "modules": [
    { "type": "custom", "format": "{#38;2;0;200;160}Static Linux{#90}   fast. private. yours." },
    { "type": "title", "format": "{#90}{user-name}{#0}@{#38;2;0;200;160}{host-name}" },
    { "type": "custom", "format": "{#90}──────────────────────────────" },
    { "type": "os",       "key": "  distro" },
    { "type": "kernel",   "key": "  kernel", "format": "{2}" },
    { "type": "uptime",   "key": "  uptime", "format": "{?1}{1}d {?}{?2}{2}h {?}{3}m" },
    { "type": "packages", "key": "  pkgs  ", "format": "{pacman}" },
    { "type": "wm",       "key": "  wm    ", "format": "{1}" },
    { "type": "shell",    "key": "  shell ", "format": "{1} {4}" },
    { "type": "memory",   "key": "  memory" },
    "break",
    { "type": "colors", "symbol": "circle", "block": { "width": 2 } }
  ]
}
