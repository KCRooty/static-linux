// Static Linux — fastfetch (rendered per accent by branding/accents/apply.sh)
// Accent: @LABEL@   dominant @ACCENT_HEX@ · detail @DETAIL_HEX@ · text @TEXT_HEX@
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "/usr/share/static-linux/fastfetch/logo-static-linux.fastfetch",
    "color": { "1": "@ACCENT_ANSI@" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },

  "display": {
    "separator": "   ",
    "color": { "keys": "@ACCENT_ANSI@", "output": "@TEXT_ANSI@" },
    "percent": {
      "type": 1,
      "color": { "green": "@DETAIL_ANSI@", "yellow": "@DETAIL_ANSI@", "red": "@DETAIL_ANSI@" }
    }
  },

  "modules": [
    { "type": "title",  "format": "{#@ACCENT_ANSI@}{user-name}{#@DIM_ANSI@}@{#@TEXT_ANSI@}{host-name}" },
    { "type": "custom", "format": "{#@DIM_ANSI@}fast. private. yours." },
    "break",
    { "type": "os",       "key": "distro " },
    { "type": "kernel",   "key": "kernel ", "format": "{2}" },
    { "type": "packages", "key": "pkgs   ", "format": "{pacman}" },
    { "type": "uptime",   "key": "uptime ", "format": "{?1}{1}d {?}{?2}{2}h {?}{3}m" },
    { "type": "shell",    "key": "shell  ", "format": "{1} {4}" },
    "break",
    { "type": "de",       "key": "desktop", "format": "{2}" },
    { "type": "wm",       "key": "wm     ", "format": "{1}" },
    { "type": "wmtheme",  "key": "theme  " },
    { "type": "terminal", "key": "term   ", "format": "{5}" },
    "break",
    { "type": "cpu",      "key": "cpu    ", "format": "{1}" },
    { "type": "gpu",      "key": "gpu    ", "format": "{2}", "temp": false },
    { "type": "memory",   "key": "memory ", "format": "{1} / {2}" },
    { "type": "disk",     "key": "disk   ", "folders": "/", "format": "{1} / {2}" },
    "break",
    { "type": "colors", "symbol": "circle", "block": { "width": 2 } }
  ]
}
