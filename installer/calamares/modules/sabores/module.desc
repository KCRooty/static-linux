---
# Static Linux — Calamares job: install the chosen flavor (sabor) packages.
# Reads globalStorage "packagechooser_sabores" (the "Sabores" page, a
# packagechooser instance). Runs right after "users", see main.py.
type:       "job"
name:       "sabores"
interface:  "python"
script:     "main.py"
