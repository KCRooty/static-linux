/* Static Linux — Calamares stylesheet.
 * Void ground, Signal Green for anything active, 70s warm tones for
 * warnings. Object names: src/libcalamaresui/ViewManager.cpp and the
 * per-module .ui files in the Calamares source. */

/* ---- ground -------------------------------------------------------- */
* { font-family: "Space Grotesk"; }

#mainApp, #viewManager, #viewManagerStack, QStackedWidget, QScrollArea,
QScrollArea > QWidget > QWidget, QDialog, QMessageBox {
    background-color: #12141A;
    color: #D6D8E0;
}
QLabel { color: #D6D8E0; background: transparent; }
QToolTip {
    background-color: #1C1F27; color: #D6D8E0;
    border: 1px solid #00C8A0; border-radius: 6px; padding: 4px 8px;
}

/* ---- buttons ------------------------------------------------------- */
QPushButton {
    background-color: #1C1F27;
    color: #D6D8E0;
    border: 1px solid #2C303C;
    border-radius: 10px;
    padding: 7px 18px;
    min-height: 18px;
}
QPushButton:hover   { background-color: #252935; border-color: #00C8A0; }
QPushButton:pressed { background-color: #0E3B33; }
QPushButton:disabled { color: #555A66; border-color: #22252E; background-color: #16181E; }
QPushButton#view-button-next {
    background-color: #00C8A0; color: #0B0C10; border-color: #00C8A0; font-weight: bold;
}
QPushButton#view-button-next:hover    { background-color: #2EE0BC; }
QPushButton#view-button-next:disabled { background-color: #1E3B35; color: #4E6B64; border-color: #1E3B35; }
QPushButton#view-button-cancel:hover  { border-color: #E8792B; color: #F2B33D; }

/* ---- inputs -------------------------------------------------------- */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit, QTextBrowser {
    background-color: #1A1D25;
    color: #E6E8EE;
    border: 1px solid #2C303C;
    border-radius: 8px;
    padding: 5px 8px;
    selection-background-color: #00C8A0;
    selection-color: #0B0C10;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus { border-color: #00C8A0; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background-color: #1A1D25; color: #E6E8EE;
    border: 1px solid #2C303C; selection-background-color: #00C8A0; selection-color: #0B0C10;
}

/* ---- lists (environment / privacy pickers, keyboard, partitions) ----- */
/* custom item views (partition legend, ...) paint with the Base role */
QAbstractItemView { background-color: #12141A; color: #D6D8E0; }
QListView, QTreeView, QTableView, QListWidget, QTreeWidget {
    background-color: #161920;
    color: #D6D8E0;
    border: 1px solid #262A34;
    border-radius: 10px;
    padding: 4px;
    outline: none;
}
QListView::item, QListWidget::item { padding: 8px 10px; border-radius: 8px; }
QListView::item:hover, QListWidget::item:hover { background-color: #1F232D; }
QListView::item:selected, QListWidget::item:selected,
QTreeView::item:selected, QTableView::item:selected {
    background-color: #00C8A0; color: #0B0C10;
}
QHeaderView::section {
    background-color: #1A1D25; color: #8A8F9C; border: none; padding: 4px 8px;
}

/* ---- progress ------------------------------------------------------ */
QProgressBar {
    background-color: #1A1D25; border: none; border-radius: 7px;
    height: 14px; text-align: center; color: #0B0C10;
}
QProgressBar::chunk {
    border-radius: 7px;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #C2452D, stop:0.35 #E8792B, stop:0.65 #F2B33D, stop:1 #00C8A0);
}

/* ---- scrollbars ---------------------------------------------------- */
QScrollBar:vertical   { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle    { background: #2C303C; border-radius: 4px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #00C8A0; }
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page { background: none; border: none; width: 0; height: 0; }

QCheckBox, QRadioButton { color: #D6D8E0; spacing: 8px; }
QGroupBox { border: 1px solid #262A34; border-radius: 10px; margin-top: 14px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; color: #F2B33D; }

/* the sidebar step list is a QListView too: keep it flat on the sidebar */
#sidebarApp QListView, #sidebarMenuApp {
    background: transparent; border: none; padding: 0; border-radius: 0;
}
#sidebarApp QPushButton { background: transparent; border: none; color: #8A8F9C; }
#sidebarApp QPushButton:hover { color: #00C8A0; }
