# No `images:` section yet. Calamares resolves these against files
# alongside branding.desc (this directory), not arbitrary repo paths — so
# using branding/wallpapers/purple/void-purple.png here would mean either
# duplicating that PNG into this directory or confirming Calamares accepts
# a relative path out of it, neither of which is verified. Once Core has a
# real SF monogram (productIcon/productLogo) and picks a wallpaper for this
# directory, add:
#   images:
#     productIcon: "sf-icon.png"
#     productLogo: "sf-logo.png"
#     productWelcome: "void-purple.png"
#     productWallpaper: "void-purple.png"
# Calamares runs fine without an images: section — it falls back to no logo.

style:
