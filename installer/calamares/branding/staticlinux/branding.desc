---
componentName: staticlinux

welcomeStyleCalamares: false
welcomeExpandingLogo: true

windowExpanding: normal
windowSize: 800px,520px
windowPlacement: center

sidebar: widget
navigation: widget

strings:
  productName: "Static Linux"
  shortProductName: "Static Linux"
  version: "2026.09"
  shortVersion: "2026.09"
  versionedName: "Static Linux 2026.09"
  shortVersionedName: "SL 2026.09"
  bootloaderEntryName: "Static Linux"
  productUrl: "https://github.com/KCRooty/static-linux"
  supportUrl: "https://github.com/KCRooty/static-linux/issues"
  knownIssuesUrl: "https://github.com/KCRooty/static-linux/issues"
  releaseNotesUrl: "https://github.com/KCRooty/static-linux/releases"

# Calamares treats a missing images: section as fatal. These are
# placeholders cut from branding/wallpapers/purple/void-purple.png until the
# real SF monogram artwork exists — replace icon.png with it, same filename.
# Files must sit next to this branding.desc.
images:
  productIcon: "icon.png"
  productLogo: "icon.png"
  productWelcome: "welcome.png"

style:
  SidebarBackground: "#0B0C10"
  SidebarText: "#D6D8E0"
  SidebarTextCurrent: "#0B0C10"
  SidebarBackgroundCurrent: "#00C8A0"

# Calamares refuses to start without a slideshow key ("key not found:
# slideshow" is fatal) — found on the first real boot of the ISO.
slideshow: "show.qml"
slideshowAPI: 2
