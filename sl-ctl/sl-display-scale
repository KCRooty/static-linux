#!/bin/bash
# Static Linux — recommended UI scale for the primary X11 screen.
#
# Prints 1, 1.25, 1.5 or 2 from the screen's real density (pixels / physical
# millimetres reported by the monitor). Screens that report no size (VMs,
# some projectors) fall back to the width alone, conservatively. Used by the
# live installer (QT_SCALE_FACTOR) and recorded for the installed system
# (/etc/static-linux/display-scale), which XFCE/Openbox/LightDM apply.
#
#   sl-display-scale          -> 1.5
#   sl-display-scale --dpi    -> 144   (96 x scale, for Xft.dpi)

set -uo pipefail

line="$(xrandr --query 2>/dev/null | awk '/ connected primary/{print; exit}')"
[[ -n "$line" ]] || line="$(xrandr --query 2>/dev/null | awk '/ connected/{print; exit}')"

w=0; mm=0
if [[ "$line" =~ ([0-9]+)x([0-9]+)\+[0-9]+\+[0-9]+ ]]; then w="${BASH_REMATCH[1]}"; fi
if [[ "$line" =~ ([0-9]+)mm\ x\ ([0-9]+)mm ]]; then mm="${BASH_REMATCH[1]}"; fi

scale=1
if (( w > 0 && mm > 50 )); then
    dpi=$(( w * 254 / (mm * 10) ))            # px per inch
    if   (( dpi >= 190 )); then scale=2
    elif (( dpi >= 150 )); then scale=1.5
    elif (( dpi >= 120 )); then scale=1.25
    fi
elif (( w >= 3800 )); then
    scale=2
fi

if [[ "${1:-}" == "--dpi" ]]; then
    case "$scale" in 1) echo 96 ;; 1.25) echo 120 ;; 1.5) echo 144 ;; 2) echo 192 ;; esac
else
    echo "$scale"
fi
