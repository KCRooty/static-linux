_stock_os_release=../usr/lib/os-release
_sl_os_release=/usr/lib/static-linux/os-release

# Point /etc/os-release at ours. A hand-made regular file is left alone.
_link_os_release() {
    if [ -L /etc/os-release ] || [ ! -e /etc/os-release ]; then
        ln -sfn "$_sl_os_release" /etc/os-release
    else
        echo "==> /etc/os-release is a regular file — not replacing it."
        echo "    To identify as Static Linux: ln -sfn $_sl_os_release /etc/os-release"
    fi
    rm -f /etc/os-release.pacnew
}

post_install() {
    _link_os_release
    sh /usr/lib/static-linux/entornos/xfce-themed/panel-internal.sh
    command -v update-desktop-database >/dev/null && update-desktop-database -q /usr/share/applications
    command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null

    cat <<'EOF'

==> Static Linux base installed.
    Next: pick an environment (pacman -S --needed - < /usr/lib/static-linux/packages/lists/<env>.list
    then /usr/lib/static-linux/entornos/<env>/install.sh --home), or run
    Calamares if you're on the installer.

    sl-detect --all   sl-ctl info   sl-welcome
EOF
}

post_upgrade() {
    post_install
}

post_remove() {
    # back to the stock Arch symlink, only if it was still ours
    if [ "$(readlink /etc/os-release 2>/dev/null)" = "$_sl_os_release" ]; then
        ln -sfn "$_stock_os_release" /etc/os-release
    fi
    command -v update-desktop-database >/dev/null && update-desktop-database -q /usr/share/applications
}
