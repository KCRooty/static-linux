# Maintainer: Static Forge <staticforge@staticforge.me>
#
# Static Linux's base meta-package — the glue between "a bunch of scripts in
# a git repo" and "a real Arch install that identifies and behaves as Static
# Linux". Everything installer/calamares/modules/*, sl-ctl and sl-welcome
# assume lives at /usr/lib/static-linux/... comes from here.
#
# This packages the monorepo in place — there's nothing to download, so
# `source=()` is empty. Run makepkg from inside a checkout:
#
#   cd packages/staticlinux-base && makepkg -si
#
# Layout shipped (see docs/wiki for the consumer side of each path):
#   /usr/lib/static-linux/sl-detect/       detect.py + rules/*.rules
#   /usr/lib/static-linux/sl-ctl/          sl-ctl.py
#   /usr/lib/static-linux/sl-welcome/      the GTK4 app + catalog/
#   /usr/lib/static-linux/accents/         apply.sh + palette.conf + templates/
#   /usr/lib/static-linux/privacidad/      3 profiles + shared lib.sh
#   /usr/lib/static-linux/packages/lists/  every packages/lists/*.list
#   /usr/lib/static-linux/packages/sf/     PKGBUILDs of Static Forge apps (sl-welcome catalog)
#   /usr/lib/static-linux/entornos/*/      install.sh + skel/ per environment
#   /usr/share/static-linux/fastfetch/     logo assets (config.jsonc: an
#                                          /etc default, not here)
#   /usr/share/static-linux/wallpapers/    gen-wallpaper.py + one PNG/accent
#   /usr/share/static-linux/hypr/static.lua  Hyprland base config (Lua)
#   /usr/share/doc/static-linux/wiki/    offline wiki (docs/build-offline-wiki.py)
#   /usr/bin/{sl-detect,sl-ctl,sl-welcome,sl-screenshot,sl-hypr-guide,sl-display-scale,sl-quick,sl-game,sl-logout} symlinks into the paths above
#
# Identity: the Static Linux os-release ships as
# /usr/lib/static-linux/os-release, and staticlinux-base.install repoints the
# /etc/os-release symlink at it (and back to ../usr/lib/os-release on
# removal). It is NOT shipped at /etc/os-release itself: on a stock Arch box
# that path already exists as an unowned symlink, so pacman either refuses
# the install (file conflict) or, with backup=(), parks ours as
# /etc/os-release.pacnew and the system keeps saying "Arch Linux" — seen on
# the PC Principal, 2026-10-11. /usr/lib/os-release (owned by `filesystem`)
# is never touched.
#
# No /etc/lsb-release either: the `lsb-release` package (a dependency of
# Steam, among others) owns that path, so shipping it here made
# `pacman -S steam` fail with a file conflict. lsb_release reads os-release
# anyway, so it reports Static Linux without it.

pkgname=staticlinux-base
pkgver=2026.11.13
pkgrel=1
pkgdesc="Static Linux base: identity files, sl-detect/sl-ctl/sl-welcome, environment and privacy-profile data"
arch=('any')
url="https://github.com/KCRooty/static-linux"
license=('GPL-3.0-only')
depends=('bash' 'python')
makedepends=('python-markdown' 'python-yaml'  # offline wiki (docs/build-offline-wiki.py)
             'gettext')                        # i18n/*.po -> .mo
optdepends=(
    'python-gobject: sl-welcome (GTK4 first-boot app)'
    'python-cairo: sl-welcome overview banner'
    'gtk4: sl-welcome'
    'libadwaita: sl-welcome accent theming'
    'python-yaml: sl-welcome catalog page'
    'polkit: sl-welcome privileged actions (privacy profile, catalog installs)'
    'pacman-contrib: sl-ctl update (checkupdates etc.)'
    'fastfetch: branded system info'
    'lightdm-gtk-greeter: login screen in the theme (sl-theme --system)'
    'plymouth: boot splash in the theme (sl-theme --system)'
    'adw-gtk-theme: sl-theme (GTK3 apps in the theme colours)'
    'papirus-icon-theme: sl-theme (folders in the theme colour)'
    'reflector: sl-ctl mirror'
    'snapper: sl-ctl snapshot (BTRFS installs only)'
)
backup=(
    'etc/fastfetch/config.jsonc'
    'etc/xdg/mimeapps.list'
    'etc/static-linux/accent'
    'etc/makepkg.conf.d/static-linux.conf'
    'etc/profile.d/static-linux-gpu.sh'
)
install=staticlinux-base.install
source=()
sha256sums=()

pkgver() {
    date +%Y.%m.%d
}

package() {
    local repo lib share
    repo="$(cd "$startdir/../.." && pwd)"
    lib="$pkgdir/usr/lib/static-linux"
    share="$pkgdir/usr/share/static-linux"
    cd "$repo"

    # ---- translations (i18n/) -------------------------------------------
    # Spanish source strings; one gettext catalogue per language for the
    # Python/shell tools, the installer jobs and the Astal bar.
    install -Dm644 i18n/sl_i18n.py "$lib/i18n/sl_i18n.py"
    install -Dm644 i18n/sl-i18n.sh "$lib/i18n/sl-i18n.sh"
    bash i18n/build.sh "$pkgdir/usr/share/locale"

    # ---- sl-detect ------------------------------------------------------
    install -Dm755 sl-detect/detect.py "$lib/sl-detect/detect.py"
    install -Dm644 -t "$lib/sl-detect/rules" sl-detect/rules/*.rules

    # ---- sl-ctl -----------------------------------------------------------
    install -Dm755 sl-ctl/sl-ctl.py "$lib/sl-ctl/sl-ctl.py"
    install -Dm755 sl-ctl/sl-screenshot "$lib/sl-ctl/sl-screenshot"
    install -Dm755 sl-ctl/sl-hypr-guide "$lib/sl-ctl/sl-hypr-guide"
    install -Dm755 sl-ctl/sl-display-scale "$lib/sl-ctl/sl-display-scale"
    install -Dm755 sl-ctl/sl-quick "$lib/sl-ctl/sl-quick"
    install -Dm755 sl-ctl/sl-game "$lib/sl-ctl/sl-game"
    install -Dm755 sl-ctl/sl-logout "$lib/sl-ctl/sl-logout"
    install -Dm644 branding/logo/sl-launcher.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/sl-launcher.svg"

    # ---- sl-welcome ---------------------------------------------------
    install -Dm755 sl-welcome/sl-welcome "$lib/sl-welcome/sl-welcome"
    install -Dm644 -t "$lib/sl-welcome/src" sl-welcome/src/*.py sl-welcome/src/style.css
    install -Dm644 -t "$lib/sl-welcome/src/pages" sl-welcome/src/pages/*.py
    install -Dm644 -t "$lib/sl-welcome/catalog" sl-welcome/catalog/*.yaml
    install -Dm755 sl-welcome/data/apply-profile "$lib/sl-welcome/apply-profile"
    install -Dm644 sl-welcome/data/dev.staticforge.welcome.desktop \
        "$pkgdir/usr/share/applications/dev.staticforge.welcome.desktop"
    install -Dm644 sl-welcome/data/dev.staticforge.welcome.policy \
        "$pkgdir/usr/share/polkit-1/actions/dev.staticforge.welcome.policy"

    # ---- accents (branding/accents/ -> flat, matches sl-ctl.py/sl-welcome's
    # ACCENT_DIR constant) — gen.sh and themes/ are repo-maintainer-only
    # tooling, not read by apply.sh at runtime, so they stay out of the
    # package. ------------------------------------------------------------
    install -Dm755 branding/accents/apply.sh "$lib/accents/apply.sh"
    install -Dm755 branding/accents/sync-wallpaper.sh "$lib/accents/sync-wallpaper.sh"
    install -Dm755 branding/accents/display-setup.sh "$lib/accents/display-setup.sh"
    install -Dm644 branding/accents/palette.conf "$lib/accents/palette.conf"
    install -Dm644 -t "$lib/accents/templates" branding/accents/templates/*.in

    # ---- themes: wallpaper + palette + style (DESIGN.md), applied by sl-theme
    # from the installer, sl-welcome and sl-ctl. gen_wallpaper.py stays out:
    # it is the tool that drew two of the wallpapers, not needed at runtime.
    local themes="$share/themes"
    install -Dm755 branding/themes/sl-theme "$themes/sl-theme"
    install -Dm644 -t "$themes" branding/themes/check.py branding/themes/icons.py branding/themes/xfwm4.py \
        branding/themes/system.py
    install -Dm644 -t "$themes/templates" branding/themes/templates/MANIFEST branding/themes/templates/*.in
    install -Dm644 -t "$themes/templates/styles" branding/themes/templates/styles/*.in
    install -Dm644 -t "$themes/templates/panels" branding/themes/templates/panels/*.xml branding/themes/templates/panels/docklike.rc
    for sub in openbox hypr kde system; do
        install -Dm644 -t "$themes/templates/$sub" branding/themes/templates/$sub/*.in
    done
    # the Static Forge mark, white on transparent (Plymouth splash)
    install -Dm644 branding/logo/sf-static-forge.png "$share/logo/sf-static-forge.png"
    for theme_dir in branding/themes/*/; do
        [[ -f "$theme_dir/theme.conf" ]] || continue
        id="$(basename "$theme_dir")"
        install -Dm644 -t "$themes/$id" "$theme_dir"theme.conf "$theme_dir"CREDITS
        for f in wallpaper.jpg preview.jpg; do
            [[ -f "$theme_dir/$f" ]] && install -Dm644 "$theme_dir/$f" "$themes/$id/$f"
        done
    done

    # ---- privacidad (whole tree, structure preserved — apply.sh scripts
    # source ../scripts/lib.sh relative to themselves) --------------------
    for profile in basico mejorado maximo; do
        install -Dm755 "privacidad/perfil-$profile/apply.sh" \
            "$lib/privacidad/perfil-$profile/apply.sh"
        install -Dm644 "privacidad/perfil-$profile/packages.list" \
            "$lib/privacidad/perfil-$profile/packages.list"
    done
    install -Dm644 privacidad/scripts/lib.sh "$lib/privacidad/scripts/lib.sh"

    # ---- package lists (base, per-environment, per-flavor, per-profile) -
    install -Dm644 -t "$lib/packages/lists" packages/lists/*.list

    # ---- Static Forge apps (PKGBUILDs sl-welcome builds on demand) -------
    for sf in packages/sf/*/; do
        install -Dm644 -t "$lib/packages/sf/$(basename "$sf")" "$sf"PKGBUILD
    done

    # ---- environments (install.sh + full skel/ dotfile tree) ------------
    for env in xfce-themed openbox-minimal hyprland-astal-full hyprland-astal-lite \
               hyprland-common kde-plasma gnome cinnamon i3 bspwm sway; do
        [[ -f "entornos/$env/install.sh" ]] && \
            install -Dm755 "entornos/$env/install.sh" "$lib/entornos/$env/install.sh"
        if [[ -d "entornos/$env/skel" ]]; then
            while IFS= read -r -d '' f; do
                rel="${f#entornos/$env/skel/}"
                install -Dm644 "$f" "$lib/entornos/$env/skel/$rel"
            done < <(find "entornos/$env/skel" -type f -print0)
        fi
    done
    # autostart scripts/hooks need +x even though the rest of skel/ is data
    chmod 755 "$lib/entornos/openbox-minimal/skel/.config/openbox/autostart" 2>/dev/null || true
    chmod 755 "$lib/entornos/bspwm/skel/.config/bspwm/bspwmrc" \
              "$lib/entornos/bspwm/skel/.config/polybar/launch.sh" 2>/dev/null || true
    install -Dm644 entornos/common/deploy.sh "$lib/entornos/common/deploy.sh"
    install -Dm755 entornos/kde-plasma/firstrun.sh "$lib/entornos/kde-plasma/firstrun.sh"
    # Hyprland base config (Lua), loaded by every user's ~/.config/hypr/hyprland.lua
    install -Dm644 entornos/hyprland-common/static.lua "$pkgdir/usr/share/static-linux/hypr/static.lua"

    # ---- shared branding assets (icons/wallpapers/fastfetch logos) ------
    install -Dm644 -t "$share/fastfetch" branding/fastfetch/*.fastfetch branding/fastfetch/*.txt
    install -Dm755 branding/wallpapers/gen-wallpaper.py "$share/wallpapers/gen-wallpaper.py"
    for accent_dir in branding/wallpapers/*/; do
        accent="$(basename "$accent_dir")"
        compgen -G "$accent_dir*.png" >/dev/null || continue  # e.g. __pycache__
        # one per style: void- (retro), neon- (cyberpunk), liquid- (liquid)
        install -Dm644 -t "$share/wallpapers/$accent" "$accent_dir"/*.png
    done
    # a default wallpaper visible before the first `sl-ctl accent` / sl-welcome run
    install -Dm644 branding/wallpapers/purple/void-purple.png \
        "$pkgdir/usr/share/backgrounds/static-linux/void-purple.png"
    install -Dm644 branding/themes/ambar/wallpaper.jpg \
        "$pkgdir/usr/share/backgrounds/static-linux/ambar.jpg"

    # ---- /usr/bin entry points -------------------------------------------
    install -d "$pkgdir/usr/bin"
    ln -s /usr/lib/static-linux/sl-detect/detect.py "$pkgdir/usr/bin/sl-detect"
    ln -s /usr/lib/static-linux/sl-ctl/sl-ctl.py "$pkgdir/usr/bin/sl-ctl"
    ln -s /usr/lib/static-linux/sl-welcome/sl-welcome "$pkgdir/usr/bin/sl-welcome"
    ln -s /usr/share/static-linux/themes/sl-theme "$pkgdir/usr/bin/sl-theme"
    ln -s /usr/lib/static-linux/sl-ctl/sl-screenshot "$pkgdir/usr/bin/sl-screenshot"
    ln -s /usr/lib/static-linux/sl-ctl/sl-hypr-guide "$pkgdir/usr/bin/sl-hypr-guide"
    ln -s /usr/lib/static-linux/sl-ctl/sl-display-scale "$pkgdir/usr/bin/sl-display-scale"
    ln -s /usr/lib/static-linux/sl-ctl/sl-quick "$pkgdir/usr/bin/sl-quick"
    ln -s /usr/lib/static-linux/sl-ctl/sl-game "$pkgdir/usr/bin/sl-game"
    ln -s /usr/lib/static-linux/sl-ctl/sl-logout "$pkgdir/usr/bin/sl-logout"

    # ---- system defaults --------------------------------------------------
    install -Dm644 packages/staticlinux-base/os-release "$lib/os-release"
    install -Dm644 branding/fastfetch/config.jsonc "$pkgdir/etc/fastfetch/config.jsonc"
    # system-wide default browser, for every environment (a user's own
    # ~/.config/mimeapps.list still wins)
    install -Dm644 packages/staticlinux-base/mimeapps.list "$pkgdir/etc/xdg/mimeapps.list"
    # for desktops that bind shortcuts to .desktop files (KDE: Meta+Shift+S)
    install -Dm644 packages/staticlinux-base/sl-screenshot.desktop \
        "$pkgdir/usr/share/applications/sl-screenshot.desktop"
    install -d "$pkgdir/etc/static-linux"
    echo "purple" > "$pkgdir/etc/static-linux/accent"

    # ---- performance & stability (rendimiento/README.md) ------------------
    # vendor paths under /usr/lib so an admin's /etc file of the same name wins
    local r=rendimiento
    install -Dm644 $r/sysctl.d/70-static-linux.conf "$pkgdir/usr/lib/sysctl.d/70-static-linux.conf"
    install -Dm644 $r/zram-generator.conf "$pkgdir/usr/lib/systemd/zram-generator.conf"
    install -Dm644 $r/udev/60-static-linux-ioschedulers.rules \
        "$pkgdir/usr/lib/udev/rules.d/60-static-linux-ioschedulers.rules"
    install -Dm644 $r/modprobe.d/static-linux.conf "$pkgdir/usr/lib/modprobe.d/static-linux.conf"
    install -Dm644 $r/systemd/journald.conf "$pkgdir/usr/lib/systemd/journald.conf.d/static-linux.conf"
    install -Dm644 $r/systemd/earlyoom.conf \
        "$pkgdir/usr/lib/systemd/system/earlyoom.service.d/static-linux.conf"
    install -Dm644 $r/environment.d/60-static-linux.conf "$pkgdir/usr/lib/environment.d/60-static-linux.conf"
    install -Dm644 $r/profile.d/static-linux-gpu.sh "$pkgdir/etc/profile.d/static-linux-gpu.sh"
    install -Dm644 $r/makepkg.conf.d/static-linux.conf "$pkgdir/etc/makepkg.conf.d/static-linux.conf"
    install -Dm644 $r/scx/config.toml "$share/rendimiento/scx/config.toml"
    install -Dm644 $r/polkit/50-static-linux-scx.rules \
        "$pkgdir/usr/share/polkit-1/rules.d/50-static-linux-scx.rules"

    # ---- offline wiki: docs/wiki rendered to one HTML page, opened by
    # sl-welcome's "Wiki" link so it works without a network ---------------
    python3 docs/build-offline-wiki.py "$pkgdir/usr/share/doc/static-linux/wiki/index.html"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
