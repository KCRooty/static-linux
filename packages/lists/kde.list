plasma-desktop
plasma-workspace
kwin
kglobalacceld
systemsettings
kscreen
powerdevil
plasma-nm
plasma-pa
bluedevil
plasma-firewall
kdeplasma-addons
plasma-browser-integration
xdg-desktop-portal-kde
kwayland-integration
print-manager
kinfocenter
plasma-systemmonitor

# ---- Look -----------------------------------------------------------
breeze
breeze-gtk
kde-gtk-config
papirus-icon-theme

# ---- Login -----------------------------------------------------------
sddm
sddm-kcm

