# Static Linux — Hyprland + Astal (full)
# Tier: Recommended / ceiling (4 GB). Wayland. Modern GPU required.

# ---- Compositor ----------------------------------------------------
# Verified against archlinux.org/packages/search/json 2026-09-21.
hyprland
hyprlock
hypridle
hyprpaper
hyprpolkitagent
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
qt5-wayland
qt6-wayland

# ---- Shell / widgets (Astal — AGS successor, GTK4) ----------------
gjs
gtk4
gtk4-layer-shell
libadwaita

# ---- Bars / dock / launcher -------------------------------------
# nwg-dock-hyprland is official (extra) now — used to be AUR-only.
nwg-dock-hyprland
# rofi-wayland's own Wayland layer-shell support got upstreamed into plain
# rofi — the separate fork package doesn't exist anymore, official or AUR.
rofi
wl-clipboard
cliphist

# ---- Notifications / theming ----------------------------------
dunst
libnotify
papirus-icon-theme
nwg-look
kvantum

# ---- Core apps -----------------------------------------------
nautilus
gvfs
gvfs-mtp
kitty
loupe
mpv
file-roller
network-manager-applet
blueman

# ---- Screenshot / screen record -----------------------------
grim
slurp
hyprshot
wf-recorder

# ---- Misc hardware control -----------------------------------
brightnessctl

# ---- Login manager -----------------------------------------
sddm

# ---- Astal shell (bar) ---------------------------------------------
# AUR-only upstream; built into the ISO's local repo by
# packages/local-repo.sh (CHROOT_AUR_PKGS) and installed from there.
aylurs-gtk-shell
libastal-io-git
libastal-git
libastal-4-git
libastal-hyprland-git
libastal-tray-git
libastal-wireplumber-git
libastal-network-git
libastal-battery-git
appmenu-glib-translator-git

# ---- media / audio controls used by the binds and the bar -----------
playerctl
pavucontrol
