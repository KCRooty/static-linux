# Static Linux — Hyprland + Astal (lite)
# Tier: Standard (2 GB). Wayland. Reduced animations, Thunar instead of
# Nautilus, no dock.

hyprland
hyprlock
hypridle
swaybg
# polkit agent (password prompts): polkit-gnome, 19 MB idle vs 54 MB for the Qt
# hyprpolkitagent (measured 2026-11-14, Hyprland full was at 928 MB idle)
polkit-gnome
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
qt5-wayland
qt6-wayland

# Shell / widgets (lighter Astal setup)
gjs
gtk4
gtk4-layer-shell
libadwaita

# Launcher / clipboard
# rofi-wayland's own Wayland layer-shell support got upstreamed into plain
# rofi — the separate fork package doesn't exist anymore, official or AUR.
rofi
wl-clipboard
cliphist

# Notifications
dunst
libnotify

# Core apps (lighter picks)
thunar
thunar-volman
gvfs
kitty
mpv
imv
file-roller
network-manager-applet

# Screenshot
grim
slurp

# Login
# LightDM: the themed greeter (SDDM only got the Breeze background) and it
# stops its X server once the Wayland session starts; SDDM kept ~100 MB
# (Xorg + sddm + sddm-helper) alive for the whole session
lightdm
lightdm-gtk-greeter

# ---- Astal shell (bar) ---------------------------------------------
# AUR-only upstream; built into the ISO's local repo by
# packages/local-repo.sh (CHROOT_AUR_PKGS) and installed from there.
aylurs-gtk-shell
libastal-io-git
libastal-git
libastal-4-git
libastal-hyprland-git
libastal-tray-git
libastal-wireplumber-git
libastal-network-git
libastal-battery-git
appmenu-glib-translator-git

# ---- media / audio controls used by the binds and the bar -----------
playerctl
pavucontrol
