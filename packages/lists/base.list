# Static Linux — base package list
# Always installed, every environment, every flavor.
# One package per line. '#' comments and blank lines ignored.
# Lines tagged (AUR) are installed by paru AFTER pacstrap, not by pacstrap.

# ---- Core system --------------------------------------------------------
base
base-devel
linux-firmware
linux-firmware-whence
mkinitcpio
sudo
systemd-sysvcompat
dbus-broker

# ---- Kernel (the real one is chosen by sl-detect; headers always) ------
linux-lts
linux-lts-headers
dkms

# ---- Boot -------------------------------------------------------------
grub
efibootmgr
os-prober
grub-btrfs

# ---- Filesystems / tooling ------------------------------------------
btrfs-progs
e2fsprogs
xfsprogs
f2fs-tools
dosfstools
exfatprogs
snapper
snap-pac
inotify-tools

# ---- Memory / OOM --------------------------------------------------
zram-generator
earlyoom

# ---- Network -------------------------------------------------------
networkmanager
wpa_supplicant
iwd
modemmanager
openssh

# ---- Default browser ------------------------------------------------
# Brave Origin, Release channel. Not in the official repos: it comes from
# the ISO's local repo (packages/local-repo.sh builds Brave's own AUR
# package), which is why it is pacstrapped here with the base system and
# not listed per environment — the target's pacman can't see that repo.
brave-origin-bin

# ---- Repos / containers ------------------------------------------
flatpak
distrobox
podman
reflector
pacman-contrib

# ---- sl-welcome (first-boot app, Fase 7) --------------------------
python
python-gobject
python-cairo
python-yaml
gtk4
libadwaita
polkit

# paru is bootstrapped from the AUR by the installer (needs base-devel + rust)
# paru (AUR)

# ---- Privacy baseline (see privacidad/ for the profiles) -----------
ufw
dnscrypt-proxy
apparmor

# ---- Graphics stack (GPU-specific drivers appended by sl-detect) ---
# mesa now bundles VA-API/VDPAU support directly — libva-mesa-driver and
# mesa-vdpau were separate packages once, both gone from the repos now
# (verified against archlinux.org/packages/search/json 2026-09-21).
mesa
vulkan-icd-loader
xorg-server
xorg-xinit

# ---- Audio -------------------------------------------------------
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber

# ---- Fonts (Static Linux brand set, all SIL OFL) ------------------
ttf-jetbrains-mono
noto-fonts
noto-fonts-emoji
# Space Grotesk + Outfit, packaged in packages/staticlinux-fonts (local repo)
staticlinux-fonts

# ---- CLI essentials --------------------------------------------
git
curl
wget
rsync
htop
fastfetch
# vi (standalone) doesn't exist as a package — vim provides the vi command
# too. Verified 2026-09-21.
nano
vim
man-db
man-pages
texinfo
less
usbutils
pciutils
lsof
which

# ---- sl-screenshot (Super+Shift+S): ~/Imágenes/Capturas + clipboard ----
xdg-user-dirs
libnotify
