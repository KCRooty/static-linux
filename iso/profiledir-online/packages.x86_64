# Static Linux — online ISO package list (live environment only — this is
# NOT what ends up on the installed system; that's packages/lists/*.list,
# installed live by Calamares' basepkgs/entorno-pkgs/sabores jobs).
#
# Deliberately NOT a copy of archiso's releng packages.x86_64 — releng is
# broad on purpose (it's the universal official installer: rescue tools,
# every filesystem/RAID/VPN driver under the sun). This is trimmed to what
# actually boots Static Linux's own live session and runs Calamares against
# the filesystems/bootloader this project supports.

# ---- Kernel / boot -------------------------------------------------
base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
amd-ucode
intel-ucode
efibootmgr
os-prober
memtest86+
memtest86+-efi
syslinux
grub

# ---- Filesystems / partitioning (docs/PROYECTO.md-supported set) ---------
arch-install-scripts
gptfdisk
parted
dosfstools
e2fsprogs
exfatprogs
f2fs-tools
btrfs-progs
xfsprogs
cryptsetup
lvm2

# ---- Networking (live session needs it — Calamares installs live) -
networkmanager
iwd
wpa_supplicant
modemmanager
openssh

# ---- Live GUI: X, then the XFCE desktop listed at the end -----------
xorg-server
xorg-xinit
xorg-xsetroot
xorg-xrandr
xf86-input-libinput

# ---- Installer -------------------------------------------------------
# Static Linux's own build (packages/calamares/), from the local repo.
calamares

# ---- CLI essentials (matches packages/lists/base.list) --------------
nano
vim
man-db
man-pages
less
usbutils
pciutils
rsync
reflector
pv
smartmontools
nvme-cli

# ---- Fonts (installer text) ------------------------------------------
ttf-jetbrains-mono
staticlinux-fonts
noto-fonts

# ---- Static Linux itself -----------------------------------------------
# Not in any official repo — comes from the local repo ../build.sh wires
# into this profile's pacman.conf (packages/local-repo.sh builds it).
staticlinux-base

# ---- live desktop: XFCE in the default theme (the installer opens on top) ----
xfce4-session
xfwm4
xfce4-panel
xfdesktop
xfce4-settings
xfconf
xfce4-terminal
xfce4-whiskermenu-plugin
xfce4-pulseaudio-plugin
xfce4-notifyd
thunar
mousepad
network-manager-applet
xcape
adw-gtk-theme
papirus-icon-theme
inter-font
fastfetch
