# Static Linux — i3. Colours, font and the bar come from the theme:
include ~/.config/i3/theme
# (sl-theme writes ~/.config/i3/theme; your own changes go below or in config.d)
include ~/.config/i3/config.d/*

set $mod Mod4
floating_modifier $mod
tiling_drag modifier titlebar

# apps
bindsym $mod+Return exec kitty
bindsym $mod+e exec thunar
bindsym $mod+b exec brave-origin
bindsym $mod+space exec rofi -show drun
bindsym $mod+d exec rofi -show drun
bindsym $mod+Tab exec rofi -show window
bindsym Print exec sl-screenshot
bindsym $mod+Shift+s exec sl-screenshot

# windows
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+v floating toggle
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+h split h
bindsym $mod+s layout toggle split
bindsym $mod+w layout tabbed
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym Left resize shrink width 20 px
    bindsym Right resize grow width 20 px
    bindsym Up resize shrink height 20 px
    bindsym Down resize grow height 20 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# session
bindsym $mod+l exec xflock4 || i3lock -c 000000
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec sl-logout

# media keys
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# autostart
exec --no-startup-id ~/.fehbg
exec --no-startup-id picom -b
exec --no-startup-id dunst
exec --no-startup-id nm-applet
exec --no-startup-id xss-lock -- i3lock -c 000000
exec --no-startup-id sl-welcome --autostart
