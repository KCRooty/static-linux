[Desktop Entry]
Type=Application
Name=Static Linux — fondo de pantalla
Name[en]=Static Linux wallpaper
Comment=Pone el fondo de Static Linux en todas las pantallas
Comment[en]=Puts the Static Linux wallpaper on every monitor
Exec=/usr/lib/static-linux/accents/sync-wallpaper.sh
Icon=static-linux
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
