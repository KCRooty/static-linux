# Static Linux — jgmenu (Openbox minimal tier). Auto-discovers .desktop
# entries — no menu.xml to hand-maintain.
stay_alive = 0
hide_on_startup = 1
terminal_exec = lxterminal
terminal_args = -e

icon_size = 20
tint2_look = 0
csv_cmd = 0

color_menu_bg = #0B0C10 96
color_menu_fg = #D6D8E0 100
color_norm_bg = #0B0C10 0
color_norm_fg = #D6D8E0 100
color_sel_bg = #00C8A0 20
color_sel_fg = #00C8A0 100
color_sep_fg = #8A8F9C 40
color_title_bg = #0B0C10 96
color_title_fg = #F2C94C 100
color_scroll_ind = #D6D8E0 60
color_border = #00C8A0 40

border = 1
radius = 6
item_height = 26
item_padding_x = 8
item_margin_x = 3

font = Space Grotesk 10
columns = 1
arrow = 1
