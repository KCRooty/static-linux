<?xml version="1.0" encoding="UTF-8"?>
<!-- Static Linux — Openbox minimal. 512 MB tier: no compositor by default,
     no effects, theme falls back to Openbox's built-in default if
     "Clearlooks" isn't installed (safe — Openbox never crashes on a missing
     theme name, it just uses its own fallback). -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
  </focus>

  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>

  <theme>
    <name>Clearlooks</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <font place="ActiveWindow">
      <name>Space Grotesk</name>
      <size>10</size>
      <weight>Bold</weight>
    </font>
    <font place="InactiveWindow">
      <name>Space Grotesk</name>
      <size>10</size>
      <weight>Normal</weight>
    </font>
    <font place="MenuHeader">
      <name>Space Grotesk</name>
      <size>10</size>
    </font>
    <font place="MenuItem">
      <name>Space Grotesk</name>
      <size>10</size>
    </font>
  </theme>

  <desktops>
    <number>4</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
    <popupTime>400</popupTime>
  </desktops>

  <keyboard>
    <keybind key="W-Return">
      <action name="Execute"><command>lxterminal</command></action>
    </keybind>
    <keybind key="W-d">
      <action name="Execute"><command>jgmenu_run</command></action>
    </keybind>
    <keybind key="W-e">
      <action name="Execute"><command>pcmanfm</command></action>
    </keybind>
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="Print">
      <action name="Execute"><command>scrot ~/Pictures/%Y-%m-%d-%H%M%S.png</command></action>
    </keybind>
  </keyboard>

  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="Execute"><command>jgmenu_run</command></action>
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Execute"><command>jgmenu_run</command></action>
      </mousebind>
    </context>
    <context name="Titlebar">
      <mousebind button="Left" action="Double">
        <action name="ToggleMaximize"/>
      </mousebind>
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Move"/>
      </mousebind>
    </context>
  </mouse>

  <applications>
    <application class="*">
      <decor>yes</decor>
    </application>
  </applications>
</openbox_config>
