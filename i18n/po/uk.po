msgstr "точки відновлення {n} немає (sl-ctl snapshot --list)"

#: sl-ctl/sl-ctl.py:672
#, python-brace-format
msgid "Punto de restauración {n}: {a} paquetes vuelven a la versión de entonces."
msgstr "Точка відновлення {n}: {a} пакетів повернуться до тодішньої версії."

