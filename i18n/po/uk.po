msgstr "Синхронізація з вашим власним сервером Nextcloud."

msgid "Cliente FTP/SFTP."
msgstr "FTP/SFTP-клієнт."

msgid "Comunicación"
msgstr "Спілкування"

msgid "Discord con Vencord ya integrado: temas, plugins y mejor rendimiento en Linux."
msgstr "Discord із вбудованим Vencord: теми, плагіни та краща продуктивність у Linux."

msgid "El cliente oficial."
msgstr "Офіційний клієнт."

msgid "Mensajería."
msgstr "Месенджер."

msgid "Mensajería cifrada de extremo a extremo."
msgstr "Месенджер із наскрізним шифруванням."

msgid "Chat descentralizado (Matrix)."
msgstr "Децентралізований чат (Matrix)."

msgid "Música y audio"
msgstr "Музика й аудіо"

msgid "El cliente oficial (se instala y actualiza con spotify-launcher)."
msgstr "Офіційний клієнт (встановлюється й оновлюється через spotify-launcher)."

msgid "Temas y extensiones para Spotify. Instala Spotify primero."
msgstr "Теми та розширення для Spotify. Спочатку встановіть Spotify."

msgid "Descarga tus listas de Spotify en local (desde YouTube Music)."
msgstr "Завантажуйте свої плейлисти Spotify локально (через YouTube Music)."

msgid "Grabar y editar audio."
msgstr "Запис і редагування аудіо."

msgid "DAW profesional libre: grabación multipista y mezcla."
msgstr "Вільна професійна DAW: багатодоріжковий запис і зведення."

msgid "DAW libre para producir música, al estilo FL Studio."
msgstr "Вільна DAW для створення музики у стилі FL Studio."

msgid "Caja de ritmos."
msgstr "Драм-машина."

msgid "DAW comercial con versión de prueba; nativo en Linux."
msgstr "Комерційна DAW з пробною версією; нативна для Linux."

msgid "DAW ligero y potente (licencia de pago, prueba completa)."
msgstr "Легка й потужна DAW (платна ліцензія, повна пробна версія)."

msgid "Software de DJ."
msgstr "Програма для діджеїв."

msgid "Reproductor de música ligero."
msgstr "Легкий музичний програвач."

msgid "Vídeo"
msgstr "Відео"

msgid "Editor de vídeo libre y completo."
msgstr "Вільний і повноцінний відеоредактор."

msgid "Editor de vídeo libre, sencillo y rápido."
msgstr "Вільний відеоредактор, простий і швидкий."

msgid "Edición y color profesional (gratuito, no libre). Pesado; necesita GPU dedicada."
msgstr "Професійний монтаж і корекція кольору (безкоштовно, але не вільно). Важкий; потрібна дискретна відеокарта."

msgid "Grabar y emitir en directo."
msgstr "Запис і прямі трансляції."

msgid "Convertir y comprimir vídeo."
msgstr "Конвертація та стиснення відео."

msgid "Reproduce cualquier cosa."
msgstr "Відтворює будь-що."

msgid "Reproductor mínimo y muy rápido."
msgstr "Мінімалістичний і дуже швидкий програвач."

msgid "Grafismo y 3D"
msgstr "Графіка та 3D"

msgid "Pintura digital."
msgstr "Цифровий живопис."

msgid "Retoque fotográfico."
msgstr "Ретуш фотографій."

msgid "Gráficos vectoriales."
msgstr "Векторна графіка."

msgid "Modelado, animación y render 3D."
msgstr "3D-моделювання, анімація та рендеринг."

msgid "CAD 3D paramétrico."
msgstr "Параметрична 3D САПР."

msgid "Revelado RAW."
msgstr "Обробка RAW."

msgid "Motor de videojuegos libre."
msgstr "Вільний ігровий рушій."

msgid "Pixel art y animación (se compila desde el código)."
msgstr "Піксель-арт і анімація (збирається з вихідного коду)."

msgid "Juegos"
msgstr "Ігри"

msgid "Con Proton para jugar a juegos de Windows."
msgstr "З Proton для ігор під Windows."

msgid "Epic Games, GOG y Amazon Prime Gaming. La forma de usar Epic en Linux."
msgstr "Epic Games, GOG і Amazon Prime Gaming. Спосіб користуватися Epic у Linux."

msgid "Un sitio para todos tus juegos y lanzadores (Battle.net, EA, Ubisoft…)."
msgstr "Одне місце для всіх ваших ігор і лаунчерів (Battle.net, EA, Ubisoft…)."

msgid "Minecraft Java con varias instancias y mods."
msgstr "Minecraft Java з кількома екземплярами та модами."

msgid "Minecraft Java con los mods y modpacks de Modrinth."
msgstr "Minecraft Java з модами та збірками Modrinth."

msgid "El launcher oficial de Mojang para Minecraft Java."
msgstr "Офіційний лаунчер Mojang для Minecraft Java."

msgid "Launcher de la versión Bedrock (necesitas tenerla comprada en Google Play)."
msgstr "Лаунчер версії Bedrock (її треба мати купленою в Google Play)."

msgid "Instala Proton-GE y otras versiones de Proton/Wine con un clic."
msgstr "Встановлює Proton-GE та інші версії Proton/Wine в один клік."

msgid "Programas de Windows en entornos aislados."
msgstr "Програми Windows в ізольованих середовищах."

msgid "Rendimiento al jugar y contador de FPS."
msgstr "Продуктивність в іграх і лічильник FPS."

msgid "Emulador multisistema."
msgstr "Багатосистемний емулятор."

msgid "Emulador de GameCube y Wii."
msgstr "Емулятор GameCube і Wii."

msgid "Emulador de PlayStation 2."
msgstr "Емулятор PlayStation 2."

msgid "Desarrollo"
msgstr "Розробка"

msgid "Control de versiones (incluido en Static Linux)."
msgstr "Контроль версій (входить до Static Linux)."

msgid "GitHub desde la terminal (gh)."
msgstr "GitHub з термінала (gh)."

msgid "Contenedores, con Compose y Buildx. Recuerda añadirte al grupo docker."
msgstr "Контейнери, з Compose і Buildx. Не забудьте додати себе до групи docker."

msgid "La compilación de Microsoft, con su marketplace."
msgstr "Збірка від Microsoft, з її маркетплейсом."

msgid "VS Code compilado desde el código libre (repos oficiales)."
msgstr "VS Code, зібраний з вільного коду (офіційні репозиторії)."

msgid "VS Code sin telemetría de Microsoft."
msgstr "VS Code без телеметрії Microsoft."

msgid "Editor modal en la terminal."
msgstr "Модальний редактор у терміналі."

msgid "Git con interfaz en la terminal."
msgstr "Git з інтерфейсом у терміналі."

msgid "Comparar archivos y carpetas."
msgstr "Порівняння файлів і тек."

msgid "Cliente de bases de datos."
msgstr "Клієнт баз даних."

msgid "adb y fastboot."
msgstr "adb і fastboot."

msgid "Productividad"
msgstr "Продуктивність"

msgid "Ofimática completa, en español y con corrector."
msgstr "Повний офісний пакет із перевіркою правопису."

msgid "Notas en Markdown enlazadas."
msgstr "Пов'язані нотатки в Markdown."

msgid "Gestor de contraseñas local y libre."
msgstr "Локальний вільний менеджер паролів."

msgid "Gestor de contraseñas en la nube."
msgstr "Хмарний менеджер паролів."

msgid "Notas con sincronización cifrada."
msgstr "Нотатки із зашифрованою синхронізацією."

msgid "Notas a mano y anotar PDFs."
msgstr "Рукописні нотатки та анотації PDF."

msgid "Unir, dividir y reordenar PDFs."
msgstr "Об'єднання, поділ і впорядкування PDF."

msgid "Tareas y listas."
msgstr "Завдання та списки."

msgid "Sistema y herramientas"
msgstr "Система та інструменти"

msgid "Comprimir y descomprimir 7z, zip, rar… (incluido en Static Linux)."
msgstr "Стиснення й розпакування 7z, zip, rar… (входить до Static Linux)."

msgid "Convertir audio y vídeo (incluido en Static Linux)."
msgstr "Конвертація аудіо та відео (входить до Static Linux)."

msgid "Descargar vídeo y audio de YouTube y más (incluido en Static Linux)."
msgstr "Завантаження відео й аудіо з YouTube та інших сайтів (входить до Static Linux)."

msgid "Cliente y servidor SSH (incluido; el servidor está apagado hasta que lo actives)."
msgstr "SSH-клієнт і сервер (входять; сервер вимкнено, доки ви його не ввімкнете)."

msgid "Permisos de las apps de Flathub."
msgstr "Дозволи застосунків Flathub."

msgid "Copias del sistema para volver atrás."
msgstr "Знімки системи для відкату."

msgid "Particionar discos."
msgstr "Розмітка дисків."

msgid "Liberar espacio y borrar rastros."
msgstr "Звільнення місця та видалення слідів."

msgid "Sincronizar carpetas entre tus equipos, sin nube."
msgstr "Синхронізація тек між вашими комп'ютерами, без хмари."

msgid "Monitor de recursos en la terminal."
msgstr "Монітор ресурсів у терміналі."

msgid "USB de arranque con varias ISOs a la vez."
msgstr "Завантажувальна флешка з кількома ISO одночасно."

msgid "Máquinas virtuales"
msgstr "Віртуальні машини"

