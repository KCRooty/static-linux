msgid "La configuración de entonces está en {f} (no se restaura sola)."
msgstr "Ówczesna konfiguracja jest w {f} (nie jest przywracana automatycznie)."

#: sl-ctl/sl-ctl.py:685
msgid "Instantánea antes y después de actualizar (snap-pac): si algo sale mal, sl-ctl snapshot --rollback <n>"
msgstr "Migawka przed i po aktualizacji (snap-pac): jeśli coś pójdzie nie tak, sl-ctl snapshot --rollback <n>"

#: sl-ctl/sl-ctl.py:687
msgid "Punto de restauración creado (versiones de paquetes y /etc): si algo sale mal, sl-ctl snapshot --rollback <n>"
msgstr "Utworzono punkt przywracania (wersje pakietów i /etc): jeśli coś pójdzie nie tak, sl-ctl snapshot --rollback <n>"

#: sl-ctl/sl-ctl.py:695
msgid "AUR sin actualizar: no hay un usuario normal al que pasar. Ejecuta `paru -Sua` con tu usuario."
msgstr "AUR nie zaktualizowano: brak zwykłego użytkownika. Uruchom `paru -Sua` jako swój użytkownik."

