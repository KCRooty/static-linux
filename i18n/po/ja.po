msgstr "音量を上げる"

msgid "bajar volumen"
msgstr "音量を下げる"

msgid "silenciar"
msgstr "ミュート"

msgid "silenciar el micrófono"
msgstr "マイクをミュート"

msgid "subir brillo"
msgstr "明るさを上げる"

msgid "bajar brillo"
msgstr "明るさを下げる"

msgid "reproducir/pausar"
