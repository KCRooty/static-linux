msgid "LibreOffice en español con corrector, Obsidian, KeePassXC, Xournal++ y herramientas de PDF."
msgstr "LibreOffice zuzentzailearekin, Obsidian, KeePassXC, Xournal++ eta PDF tresnak."

#. installer page (description)
msgid "KVM/QEMU con virt-manager y GNOME Boxes, con TPM y UEFI para invitados Windows 11."
msgstr "KVM/QEMU virt-manager eta GNOME Boxes-ekin, TPM eta UEFIrekin Windows 11 gonbidatuentzat."

#. installer page (name)
msgid "Educación"
msgstr "Hezkuntza"

#. installer page (description)
