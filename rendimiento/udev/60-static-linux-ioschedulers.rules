# Static Linux — I/O scheduler per kind of disk (Arch wiki "Improving
# performance"): none for NVMe (the drive queues better than the kernel),
# mq-deadline for SATA SSDs and eMMC, BFQ for spinning disks (keeps the
# desktop responsive while something copies in the background).
ACTION=="add|change", KERNEL=="nvme[0-9]*n[0-9]*", ATTR{queue/scheduler}="none"
ACTION=="add|change", KERNEL=="sd[a-z]*|mmcblk[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
ACTION=="add|change", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
