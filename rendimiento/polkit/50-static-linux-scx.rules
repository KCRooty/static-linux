// Static Linux — let sl-game switch the sched_ext scheduler mode (Gaming ⇄ Auto)
// without a password prompt in the middle of launching a game. Only for admins
// (wheel) sitting at an active local session; same scope scx_loader already
// grants with auth_admin_keep, minus the prompt.
polkit.addRule(function (action, subject) {
    if (action.id == "org.scx.loader.manage-schedulers" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
